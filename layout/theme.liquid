<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ page_title }}</title>

  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0813/4380/7725/files/61yue4AWqcL._AC_SY300_SX300_QL70_ML2_.jpg?v=1747631069">
  <meta property="og:image:width" content="300">
  <meta property="og:image:height" content="300">
  <meta property="og:description" content="{{ page_description }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description }}">
  <meta name="twitter:image" content="https://cdn.shopify.com/s/files/1/0813/4380/7725/files/61yue4AWqcL._AC_SY300_SX300_QL70_ML2_.jpg?v=1747631069">
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "1st Plunge Ice Bath Recovery Kit",
  "description": "Professional 1/3 HP ice bath chiller with 148-gallon insulated tub. Cool to 42F with no ice needed.",
  "sku": "1ST-PLUNGE-KIT",
  "brand": { "@type": "Brand", "name": "1stplunge" },
  "offers": {
    "@type": "Offer",
    "url": "https://c4ma8z-bc.myshopify.com/products/1st-plunge-ice-bath-recovery-kit-premium-cold-therapy-system",
    "priceCurrency": "USD",
    "price": "1299.00",
    "availability": "https://schema.org/InStock"
  }
}
</script>


    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- 注入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              arctic: {
                900: '#030712',
                800: '#111827',
                600: '#2563eb',
                500: '#3b82f6',
              }
            }
          }
        }
      }
    </script>
    
    <style>
      [x-cloak] { display: none !important; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    </style>
  </head>

  <body class="bg-white min-h-screen flex flex-col font-sans antialiased text-slate-900">
    {% section 'header' %}

    <main id="MainContent" class="flex-grow focus:outline-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script shadow>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
  <script src="{{ 'landing-redirect.js' | asset_url }}" defer></script>
</body>
</html>
