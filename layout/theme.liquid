<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="google-site-verification" content="jbjVmXGG9gb7B6Lu6zkENYhGpKurZj_-HHBLXW2Bu8M" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% liquid
      assign trailnest_legacy_redirect_target = ''
      assign seo_page_title = page_title
      assign seo_page_description = page_description

      case request.path
        when '/pages/hj1'
          assign trailnest_legacy_redirect_target = '/'
        when '/pages/1st-plunge-ice-bath-recovery-kit'
          assign trailnest_legacy_redirect_target = '/collections/all-products'
        when '/pages/ice-bath-recovery-kit'
          assign trailnest_legacy_redirect_target = '/collections/all-products'
        when '/pages/recovery-tech-system'
          assign trailnest_legacy_redirect_target = '/collections/all-products'
        when '/collections/frontpage'
          assign trailnest_legacy_redirect_target = '/collections/all-products'
      endcase

      if request.page_type == 'index'
        assign seo_page_title = 'TrailNest Inflatable Camping Tents | Comfortable Family Camping'
        assign seo_page_description = 'TrailNest offers spacious inflatable camping tents for family trips, weekend escapes, and glamping-style outdoor living. Set up faster and camp in comfort.'
      elsif request.page_type == 'collection' and collection.handle == 'all-products'
        assign seo_page_title = 'Inflatable Camping Tents | TrailNest'
        assign seo_page_description = 'Shop TrailNest inflatable camping tents built for easy setup, roomy interiors, breathable comfort, and family-friendly outdoor living.'
      elsif request.page_type == 'blog' and blog.handle == 'guides'
        assign seo_page_title = 'Inflatable Tent Guides & Camping Advice | TrailNest'
        assign seo_page_description = 'Explore practical inflatable tent guides, setup advice, family camping comparisons, and glamping tips from TrailNest.'
      endif

      if seo_page_description == blank and request.page_type == 'product'
        assign seo_page_description = product.description | strip_html | strip_newlines | truncate: 155
      elsif seo_page_description == blank and request.page_type == 'article'
        assign seo_page_description = article.excerpt_or_content | strip_html | strip_newlines | truncate: 155
      elsif seo_page_description == blank and request.page_type == 'page'
        assign seo_page_description = page.content | strip_html | strip_newlines | truncate: 155
      endif

      if seo_page_description != blank
        assign seo_page_description = seo_page_description | strip_html | strip_newlines | truncate: 155
      endif
    %}
    {% if trailnest_legacy_redirect_target != blank %}
      <meta name="robots" content="noindex,follow">
      <meta http-equiv="refresh" content="0;url={{ trailnest_legacy_redirect_target }}">
      <link rel="canonical" href="{{ request.origin }}{{ trailnest_legacy_redirect_target }}">
      <script>
        window.location.replace({{ trailnest_legacy_redirect_target | json }});
      </script>
    {% else %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}
    
    <title>{{ seo_page_title | escape }}</title>

  <meta property="og:title" content="{{ seo_page_title | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0813/4380/7725/files/61yue4AWqcL._AC_SY300_SX300_QL70_ML2_.jpg?v=1747631069">
  <meta property="og:image:width" content="300">
  <meta property="og:image:height" content="300">
  <meta property="og:description" content="{{ seo_page_description | escape }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_page_title | escape }}">
  <meta name="twitter:description" content="{{ seo_page_description | escape }}">
  <meta name="twitter:image" content="https://cdn.shopify.com/s/files/1/0813/4380/7725/files/61yue4AWqcL._AC_SY300_SX300_QL70_ML2_.jpg?v=1747631069">
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Organization",
  "name": "TrailNest",
  "url": "https://c4ma8z-bc.myshopify.com/",
  "description": {{ 'trailnest.schema.description' | t | json }}
}
</script>

{% render 'trailnest-seo-jsonld' %}


    {% if seo_page_description != blank %}
      <meta name="description" content="{{ seo_page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- 注入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              arctic: {
                900: '#030712',
                800: '#111827',
                600: '#2563eb',
                500: '#3b82f6',
              }
            }
          }
        }
      }
    </script>
    
    <style>
      [x-cloak] { display: none !important; }
      body { font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    </style>
  </head>

  <body class="bg-white min-h-screen flex flex-col font-sans antialiased text-slate-900">
    {% section 'header' %}

    <main id="MainContent" class="flex-grow focus:outline-none" role="main" tabindex="-1">
      {% if template.name == 'index' %}
        {% section 'trailnest-inflatable-home' %}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% section 'footer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script shadow>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
  <script src="{{ 'landing-redirect.js' | asset_url }}" defer></script>
</body>
</html>
