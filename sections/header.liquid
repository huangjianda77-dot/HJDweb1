{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

<style>
  .rs-header { position: sticky; top: 0; z-index: 50; background: rgba(24, 31, 23, .94); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(232, 220, 193, .2); }
  .rs-header-wrap { width: min(1200px, calc(100% - 32px)); min-height: 68px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 22px; }
  .rs-brand { display: inline-flex; align-items: center; gap: 10px; color: #fffaf0; text-decoration: none; font-weight: 950; white-space: nowrap; }
  .rs-brand-mark { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; color: #1b241b; background: #d8b56d; border-radius: 6px; font-size: 13px; }
  .rs-nav { display: flex; align-items: center; gap: 24px; }
  .rs-nav a { color: #d8d0bd; text-decoration: none; font-size: 13px; font-weight: 850; white-space: nowrap; }
  .rs-nav a:hover { color: #fffaf0; }
  .rs-header-actions { display: flex; align-items: center; gap: 10px; }
  .rs-cart { color: #fffaf0; text-decoration: none; font-size: 13px; font-weight: 850; white-space: nowrap; }
  .rs-buy { min-height: 38px; display: inline-flex; align-items: center; padding: 0 16px; border-radius: 4px; color: #1b241b; background: #d8b56d; text-decoration: none; font-size: 13px; font-weight: 950; white-space: nowrap; }
  .rs-locale-form { margin: 0; }
  .rs-locale-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .rs-locale-select { min-height: 38px; max-width: 120px; border: 1px solid rgba(255,248,234,.24); border-radius: 4px; background: rgba(255,248,234,.08); color: #fffaf0; font-size: 12px; font-weight: 850; padding: 0 8px; }
  .rs-locale-select option { color: #1b241b; }
  @media (max-width: 900px) { .rs-nav { gap: 14px; } .rs-header-wrap { gap: 12px; } }
	  @media (max-width: 760px) {
	    .rs-header-wrap { width: min(100% - 20px, 1200px); min-height: 58px; flex-wrap: wrap; gap: 8px 12px; padding: 8px 0; }
	    .rs-brand { gap: 8px; font-size: 20px; }
	    .rs-brand-mark { width: 40px; height: 40px; flex-basis: 40px; border-radius: 8px; font-size: 14px; }
	    .rs-nav { order: 3; width: 100%; display: flex; overflow-x: auto; gap: 18px; padding: 2px 0 3px; scrollbar-width: none; }
	    .rs-nav::-webkit-scrollbar { display: none; }
	    .rs-header-actions { gap: 8px; }
	    .rs-cart { display: none; }
	    .rs-buy { min-height: 40px; padding: 0 14px; border-radius: 6px; font-size: 14px; }
	    .rs-locale-select { min-height: 34px; max-width: 92px; }
	  }
	  @media (max-width: 420px) {
	    .rs-header-wrap { width: min(100% - 18px, 1200px); }
	    .rs-brand { font-size: 18px; }
	    .rs-brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
	    .rs-nav { gap: 14px; }
	    .rs-nav a { font-size: 12px; }
	    .rs-buy { min-height: 36px; padding: 0 12px; font-size: 12px; }
	  }
</style>

<header class="rs-header">
  <div class="rs-header-wrap">
    <a class="rs-brand" href="/"><span class="rs-brand-mark">TN</span><span>{{ 'trailnest.brand.name' | t }}</span></a>
    <nav class="rs-nav" aria-label="Primary navigation">
      <a href="/#tent-life">{{ 'trailnest.nav.inflatable_tents' | t }}</a>
      <a href="/#tent-life">{{ 'trailnest.nav.camping_life' | t }}</a>
      <a href="/pages/about-trailnest">{{ 'trailnest.nav.about' | t }}</a>
  <a href="/collections/all-products">All Products</a>
    </nav>
    <div class="rs-header-actions">
      {% form 'localization', class: 'rs-locale-form' %}
        {% if localization.available_languages.size > 1 %}
          <label class="rs-locale-label" for="HeaderLanguage-{{ section.id }}">{{ 'trailnest.language.label' | t }}</label>
          <select id="HeaderLanguage-{{ section.id }}" class="rs-locale-select" name="locale_code" onchange="this.form.submit()">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
            {% endfor %}
          </select>
        {% endif %}
      {% endform %}
      <a class="rs-cart" href="/cart">{{ 'trailnest.actions.cart' | t }}</a>
      <a class="rs-buy" href="/products/trailnest-inflatable-cabin-tent">{{ 'trailnest.actions.shop_tents' | t }}</a>
    </div>
  </div>
</header>
