{{ 'trailnest-national.css' | asset_url | stylesheet_tag }}
<header class="tnp-header">
  <div class="tnp-header__inner">
    <a class="tnp-brand" href="/" aria-label="TrailNest home">
      <span class="tnp-brand__word">TRAILNEST</span>
      <span class="tnp-brand__mark">OUTDOORS</span>
    </a>
    <nav class="tnp-header__nav" aria-label="Primary navigation">
      <a href="/collections/all-products#rooftop-tents">Rooftop Tents</a>
      <a href="/collections/all-products#inflatable-tents">Inflatable Tents</a>
      <a href="/blogs/guides">Field Notes</a>
      <a href="/pages/about-trailnest">Our Story</a>
    </nav>
    <div class="tnp-header__actions">
      <a class="tnp-header__cart" href="/cart">Bag ({{ cart.item_count }})</a>
      <a class="tnp-header__action" href="/collections/all-products">Shop all <span class="tnp-arrow">→</span></a>
    </div>
  </div>
</header>
{% schema %}
{"name":"TrailNest Header","settings":[]}
{% endschema %}
