{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

<style>
  .rs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(18, 28, 24, .9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(232, 220, 193, .2);
  }
  .rs-header-wrap {
    width: min(1200px, calc(100% - 32px));
    height: 68px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }
  .rs-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fffaf0;
    text-decoration: none;
    font-weight: 950;
  }
  .rs-brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    color: #142018;
    background: #d9b86f;
    border-radius: 6px;
    font-size: 13px;
  }
  .rs-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .rs-nav a {
    color: #cfc6ae;
    text-decoration: none;
    font-size: 13px;
    font-weight: 850;
  }
  .rs-nav a:hover { color: #fffaf0; }
  .rs-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rs-cart {
    color: #fffaf0;
    text-decoration: none;
    font-size: 13px;
    font-weight: 850;
  }
  .rs-buy {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 4px;
    color: #142018;
    background: #d9b86f;
    text-decoration: none;
    font-size: 13px;
    font-weight: 950;
  }
  @media (max-width: 760px) {
    .rs-nav { display: none; }
    .rs-header-wrap { width: min(100% - 24px, 1200px); }
  }
</style>

<header class="rs-header">
  <div class="rs-header-wrap">
    <a class="rs-brand" href="/">
      <span class="rs-brand-mark">TN</span>
      <span>TrailNest</span>
    </a>
    <nav class="rs-nav" aria-label="Primary navigation">
      <a href="/collections/all">Gear</a>
      <a href="/#trailnest-living">Outdoor Living</a>
      <a href="/pages/about-trailnest">About</a>
    </nav>
    <div class="rs-header-actions">
      <a class="rs-cart" href="/cart">Cart</a>
      <a class="rs-buy" href="/collections/all">Shop Gear</a>
    </div>
  </div>
</header>