{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

<style>
  .rs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(6, 11, 20, .88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(125, 211, 252, .16);
  }
  .rs-header-wrap {
    width: min(1200px, calc(100% - 32px));
    height: 68px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }
  .rs-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #f8fbff;
    text-decoration: none;
    font-weight: 950;
  }
  .rs-brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    color: #06101f;
    background: linear-gradient(135deg, #41f0b4, #21d4fd);
    border-radius: 6px;
    font-size: 14px;
  }
  .rs-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .rs-nav a {
    color: #9fb1c7;
    text-decoration: none;
    font-size: 13px;
    font-weight: 850;
  }
  .rs-nav a:hover { color: #21d4fd; }
  .rs-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rs-cart {
    color: #d8e8f8;
    text-decoration: none;
    font-size: 13px;
    font-weight: 850;
  }
  .rs-buy {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 4px;
    color: #06101f;
    background: linear-gradient(135deg, #41f0b4, #21d4fd);
    text-decoration: none;
    font-size: 13px;
    font-weight: 950;
  }
  @media (max-width: 760px) {
    .rs-nav { display: none; }
    .rs-header-wrap { width: min(100% - 24px, 1200px); }
  }
</style>

<header class="rs-header">
  <div class="rs-header-wrap">
    <a class="rs-brand" href="/">
      <span class="rs-brand-mark">R1</span>
      <span>1st Plunge Recovery</span>
    </a>
    <nav class="rs-nav" aria-label="Primary navigation">
      <a href="/">System</a>
      <a href="/#recovery-tech">Technology</a>
      <a href="/products/1st-plunge-ice-bath-recovery-kit-premium-cold-therapy-system">Product</a>
    </nav>
    <div class="rs-header-actions">
      <a class="rs-cart" href="/cart">Cart</a>
      <a class="rs-buy" href="/products/1st-plunge-ice-bath-recovery-kit-premium-cold-therapy-system">Buy Kit</a>
    </div>
  </div>
</header>
