{% schema %}
{
  "name": "CTA Section",
  "settings": [],
  "presets": [{ "name": "CTA Section" }]
}
{% endschema %}

<section class="relative py-32 bg-blue-600 overflow-hidden text-center text-white">
  <div class="relative z-10 max-w-4xl mx-auto px-4">
    <h2 class="text-4xl md:text-6xl font-black mb-8 tracking-tighter uppercase leading-tight">
      Ready to redefine <br>
      <span class="italic font-serif normal-case tracking-normal text-blue-200">your peak?</span>
    </h2>
    <p class="text-blue-100 mb-12 text-lg font-medium tracking-widest uppercase opacity-80">
      Join 10,000+ athletes. Order today and get free 2-day priority shipping.
    </p>
    <button class="px-16 py-6 bg-white text-blue-900 font-black uppercase tracking-[0.3em] text-xs hover:scale-105 transition-transform shadow-2xl active:scale-95 leading-none">
      Order Now
    </button>
  </div>
  <!-- Abstract Shapes -->
  <div class="absolute -top-24 -left-24 w-96 h-96 border border-white/10 rounded-full"></div>
  <div class="absolute -bottom-24 -right-24 w-[30rem] h-[30rem] border border-white/5 rounded-full"></div>
</section>
