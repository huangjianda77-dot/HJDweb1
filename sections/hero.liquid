{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BORN FOR CHAMPIONS"
    }
  ],
  "presets": [{ "name": "Hero Section" }]
}
{% endschema %}

<section class="relative min-h-[85vh] flex items-center bg-zinc-900 overflow-hidden">
  <div class="absolute inset-0 opacity-50">
    <img src="https://images.unsplash.com/photo-1593079831268-3381b0db4a77?auto=format&fit=crop&q=80&w=2000" class="w-full h-full object-cover">
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/40 to-transparent"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 w-full">
    <div class="max-w-2xl">
      <span class="inline-block px-4 py-2 mb-8 text-[10px] font-black tracking-[0.3em] text-blue-400 uppercase border border-blue-400/30 rounded-full bg-blue-400/10">
        THE ARCTIC PLUNGE PRO
      </span>
      <h1 class="text-5xl md:text-8xl font-black text-white leading-[0.95] mb-8 tracking-tighter">
        {{ section.settings.heading }}
      </h1>
      <p class="text-lg md:text-xl text-zinc-400 mb-12 max-w-lg leading-relaxed">
        Experience elite-level recovery in your own space. Our triple-layer insulation technology keeps water ice-cold for 24+ hours.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-5">
        <a href="#" class="px-12 py-5 bg-blue-600 text-white font-bold uppercase tracking-[0.2em] text-xs hover:bg-blue-500 transition-all flex items-center justify-center group">
          Get Started <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-3 group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#" class="px-12 py-5 bg-white border border-white text-zinc-900 font-bold uppercase tracking-[0.2em] text-xs hover:bg-transparent hover:text-white transition-all text-center">
          Learn Science
        </a>
      </div>
    </div>
  </div>
</section>
