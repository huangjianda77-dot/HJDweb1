{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} { --tn-forest:#182418; --tn-paper:#fff8ea; --tn-ink:#20261f; --tn-muted:#6c705f; --tn-line:rgba(32,38,31,.14); --tn-gold:#d8b56d; background: var(--tn-paper); color: var(--tn-ink); }
  .tn-cart * { box-sizing: border-box; }
  .tn-cart { padding: 62px 0 84px; background: var(--tn-paper); }
  .tn-cart-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  .tn-cart-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 28px; }
  .tn-cart-eyebrow { margin: 0 0 8px; color: #a96746; font-size: 12px; font-weight: 950; letter-spacing: .16em; text-transform: uppercase; }
  .tn-cart h1 { margin: 0; font-size: 44px; line-height: 1.04; font-weight: 950; letter-spacing: 0; }
  .tn-cart-subhead { margin: 10px 0 0; max-width: 520px; color: var(--tn-muted); font-size: 16px; line-height: 1.55; font-weight: 750; }
  .tn-cart-continue { color: var(--tn-forest); font-size: 14px; font-weight: 900; text-decoration: underline; text-underline-offset: 4px; }
  .tn-cart-empty { min-height: 260px; display: grid; place-items: center; padding: 42px; border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; text-align: center; }
  .tn-cart-empty h2 { margin: 0; font-size: 30px; font-weight: 950; }
  .tn-cart-empty p { margin: 12px auto 0; max-width: 520px; color: var(--tn-muted); font-size: 16px; line-height: 1.65; }
  .tn-cart-button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; margin-top: 24px; padding: 0 22px; border: 0; border-radius: 4px; background: var(--tn-gold); color: var(--tn-forest); font-size: 14px; font-weight: 950; text-decoration: none; cursor: pointer; }
  .tn-cart-form { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: start; }
  .tn-cart-items { display: grid; gap: 12px; }
  .tn-cart-item { display: grid; grid-template-columns: 124px minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 14px; border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; box-shadow: 0 12px 30px rgba(24,36,24,.05); }
  .tn-cart-item-image { overflow: hidden; border-radius: 6px; background: #f5f1e8; }
  .tn-cart-item-image img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: contain; padding: 8px; }
  .tn-cart-item-main { min-width: 0; }
  .tn-cart-item-title { display: inline-block; margin: 0; color: var(--tn-ink); font-size: 18px; line-height: 1.2; font-weight: 950; text-decoration: none; }
  .tn-cart-item-meta { margin-top: 7px; color: var(--tn-muted); font-size: 12px; line-height: 1.35; font-weight: 850; }
  .tn-cart-qty-row { display: flex; align-items: center; gap: 10px; margin-top: 13px; }
  .tn-cart-qty { width: 74px; min-height: 40px; border: 1px solid var(--tn-line); border-radius: 4px; padding: 0 10px; background: #fff; color: var(--tn-ink); font-weight: 850; }
  .tn-cart-remove { color: var(--tn-muted); font-size: 12px; font-weight: 850; text-decoration: underline; text-underline-offset: 3px; }
  .tn-cart-line-price { text-align: right; font-size: 18px; font-weight: 950; white-space: nowrap; }
  .tn-cart-summary { position: sticky; top: 92px; padding: 22px; border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; box-shadow: 0 18px 44px rgba(24,36,24,.07); }
  .tn-cart-summary h2 { margin: 0 0 16px; font-size: 22px; font-weight: 950; }
  .tn-cart-summary-row { display: flex; justify-content: space-between; gap: 14px; padding: 14px 0; border-top: 1px solid rgba(32,38,31,.1); font-weight: 850; }
  .tn-cart-summary-row.total { font-size: 22px; font-weight: 950; }
  .tn-cart-note { margin: 12px 0 0; color: var(--tn-muted); font-size: 13px; line-height: 1.5; }
  .tn-cart-assurances { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(32,38,31,.1); }
  .tn-cart-assurance { display: flex; align-items: center; gap: 9px; color: var(--tn-muted); font-size: 12px; font-weight: 850; }
  .tn-cart-assurance::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--tn-gold); box-shadow: 0 0 0 4px rgba(216,181,109,.18); flex: 0 0 auto; }
  .tn-cart-actions { display: grid; gap: 10px; margin-top: 20px; }
  .tn-cart-update { min-height: 48px; border: 1px solid var(--tn-line); border-radius: 4px; background: #fff; color: var(--tn-forest); font-size: 13px; font-weight: 950; cursor: pointer; }
  .tn-cart-checkout { min-height: 54px; border: 0; border-radius: 4px; background: var(--tn-forest); color: var(--tn-paper); font-size: 14px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  @media (max-width: 860px) {
    .tn-cart-form { grid-template-columns: 1fr; }
    .tn-cart-summary { position: static; }
  }
  @media (max-width: 620px) {
    .tn-cart { padding: 30px 0 54px; }
    .tn-cart-wrap { width: min(100% - 28px, 1120px); }
    .tn-cart-head { display: grid; gap: 14px; align-items: start; margin-bottom: 18px; }
    .tn-cart-eyebrow { font-size: 11px; margin-bottom: 6px; }
    .tn-cart h1 { font-size: 32px; }
    .tn-cart-subhead { margin-top: 8px; font-size: 14px; }
    .tn-cart-continue { font-size: 13px; }
    .tn-cart-form { gap: 14px; }
    .tn-cart-item { grid-template-columns: 104px minmax(0, 1fr); gap: 12px; padding: 12px; align-items: start; }
    .tn-cart-item-title { font-size: 16px; }
    .tn-cart-item-meta { font-size: 11px; }
    .tn-cart-qty-row { margin-top: 10px; }
    .tn-cart-qty { width: 68px; min-height: 38px; }
    .tn-cart-line-price { grid-column: 2; text-align: left; margin-top: -2px; font-size: 17px; }
    .tn-cart-summary { padding: 18px; }
    .tn-cart-summary h2 { font-size: 21px; }
    .tn-cart-actions { margin-top: 16px; }
    .tn-cart-checkout { min-height: 56px; }
  }
</style>

<section class="tn-cart">
  <div class="tn-cart-wrap">
    <div class="tn-cart-head">
      <div>
        <p class="tn-cart-eyebrow">TrailNest checkout</p>
        <h1>Your cart</h1>
        <p class="tn-cart-subhead">Review your tent, quantity, and order total before moving to secure checkout.</p>
      </div>
      <a class="tn-cart-continue" href="/products/trailnest-inflatable-cabin-tent">Continue shopping</a>
    </div>

    {% if cart.item_count == 0 %}
      <div class="tn-cart-empty">
        <div>
          <h2>Your cart is empty</h2>
          <p>Start with the TrailNest inflatable cabin tent and build a more comfortable camp setup.</p>
          <a class="tn-cart-button" href="/products/trailnest-inflatable-cabin-tent">Shop the tent</a>
        </div>
      </div>
    {% else %}
      <form class="tn-cart-form" action="{{ routes.cart_url }}" method="post">
        <div class="tn-cart-items">
          {% for item in cart.items %}
            <div class="tn-cart-item">
              <a class="tn-cart-item-image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.image.alt | default: item.product.title }}
                {% endif %}
              </a>
              <div class="tn-cart-item-main">
                <a class="tn-cart-item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <div class="tn-cart-item-meta">{{ item.variant.title }}</div>
                {% endunless %}
                {% if item.sku != blank %}<div class="tn-cart-item-meta">SKU: {{ item.sku }}</div>{% endif %}
                <div class="tn-cart-qty-row">
                  <input class="tn-cart-qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}">
                  <a class="tn-cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </div>
              <div class="tn-cart-line-price">{{ item.final_line_price | money }}</div>
            </div>
          {% endfor %}
        </div>

        <aside class="tn-cart-summary" aria-label="Cart summary">
          <h2>Order summary</h2>
          <div class="tn-cart-summary-row"><span>Items</span><span>{{ cart.item_count }}</span></div>
          <div class="tn-cart-summary-row total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <p class="tn-cart-note">Shipping, taxes, and discounts are calculated at checkout.</p>
          <div class="tn-cart-assurances" aria-label="Checkout notes">
            <div class="tn-cart-assurance">Secure checkout powered by Shopify</div>
            <div class="tn-cart-assurance">USD pricing for the U.S. market</div>
            <div class="tn-cart-assurance">Order details can be reviewed before payment</div>
          </div>
          <div class="tn-cart-actions">
            <button class="tn-cart-checkout" type="submit" name="checkout">Checkout</button>
            <button class="tn-cart-update" type="submit" name="update">Update cart</button>
          </div>
        </aside>
      </form>
    {% endif %}
  </div>
</section>
