{% assign shelter_collection = collections['all-products'] %}
<div class="tnp-collection">
  <div class="tnp-shell">
    <section class="tnp-collection__intro">
      <p class="tnp-eyebrow">TrailNest Shelter Collection</p>
      <h1>Shop Shelters</h1>
      <span>Shelter systems for the road, the campsite, and everywhere between.</span>
    </section>

    <section class="tnp-category" id="rooftop-tents">
      <header class="tnp-category__head"><div><span>Flagship category</span><h2>Rooftop Tents</h2></div><a href="#rooftop-tents">View all <span class="tnp-arrow">→</span></a></header>
      <div class="tnp-product-grid">
        {% assign rooftop_count = 0 %}
        {% for product in shelter_collection.products %}
          {% if product.handle contains 'rooftop' %}
            {% assign rooftop_count = rooftop_count | plus: 1 %}
            <a class="tnp-card" href="{{ product.url }}">
              <div class="tnp-card__image"><img src="{{ 'trailnest-wedge-132-rooftop-tent-minimal-suv-white.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="eager"></div>
              <div class="tnp-card__copy"><span>Flagship rooftop system</span><h3>{{ product.title | escape }}</h3><div class="tnp-card__bottom"><b>{{ product.price | money }}</b><b>View product <span class="tnp-arrow">→</span></b></div></div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% if rooftop_count == 0 %}<div class="tnp-empty">Our rooftop tent collection is being prepared.</div>{% endif %}
    </section>

    <section class="tnp-category" id="inflatable-tents">
      <header class="tnp-category__head"><div><span>Basecamp collection</span><h2>Inflatable Tents</h2></div><a href="#inflatable-tents">View all <span class="tnp-arrow">→</span></a></header>
      <div class="tnp-product-grid">
        {% assign inflatable_count = 0 %}
        {% for product in shelter_collection.products %}
          {% unless product.handle contains 'rooftop' %}
            {% assign inflatable_count = inflatable_count | plus: 1 %}
            <a class="tnp-card" href="{{ product.url }}">
              <div class="tnp-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</div>
              <div class="tnp-card__copy"><span>Inflatable shelter</span><h3>{{ product.title | escape }}</h3><div class="tnp-card__bottom"><b>{{ product.price | money }}</b><b>View product <span class="tnp-arrow">→</span></b></div></div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
      {% if inflatable_count == 0 %}<div class="tnp-empty">No inflatable tents are available right now.</div>{% endif %}
    </section>
  </div>
</div>
{% schema %}
{"name":"TrailNest Collection","settings":[],"presets":[{"name":"TrailNest Collection"}]}
{% endschema %}
