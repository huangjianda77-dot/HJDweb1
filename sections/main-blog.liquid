{% schema %}
{
  "name": "Blog",
  "settings": [],
  "presets": [{ "name": "Blog" }]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    --tn-paper: #f7f2e8;
    --tn-cream: #fffdfa;
    --tn-ink: #1f211d;
    --tn-muted: #747064;
    --tn-line: #e6ded1;
    --tn-gold: #caa76a;
    --tn-clay: #a76543;
    --tn-forest: #182418;
    background: var(--tn-paper);
    color: var(--tn-ink);
  }

  .tn-blog * { box-sizing: border-box; }
  .tn-blog { min-height: 70vh; overflow-x: hidden; background: linear-gradient(180deg, #fffdfa 0, var(--tn-paper) 100%); }
  .tn-blog-wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
  .tn-blog-hero { padding: 72px 0 44px; border-bottom: 1px solid var(--tn-line); }
  .tn-blog-kicker { margin: 0 0 12px; color: var(--tn-clay); font-size: 12px; font-weight: 950; letter-spacing: .16em; text-transform: uppercase; }
  .tn-blog-title { max-width: 860px; margin: 0; font-size: clamp(40px, 7vw, 76px); line-height: .96; font-weight: 950; letter-spacing: 0; }
  .tn-blog-copy { max-width: 680px; margin: 20px 0 0; color: var(--tn-muted); font-size: 18px; line-height: 1.65; }
  .tn-blog-count { display: inline-flex; align-items: center; min-height: 36px; margin-top: 22px; padding: 0 14px; border: 1px solid var(--tn-line); border-radius: 999px; background: var(--tn-cream); color: var(--tn-muted); font-size: 13px; font-weight: 850; }
  .tn-blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding: 42px 0 78px; }
  .tn-blog-card { min-width: 0; display: grid; align-content: start; min-height: 360px; padding: 26px; border: 1px solid var(--tn-line); border-radius: 10px; background: var(--tn-cream); color: var(--tn-ink); text-decoration: none; box-shadow: 0 14px 34px rgba(31,33,29,.06); transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
  .tn-blog-card:hover { transform: translateY(-2px); border-color: rgba(202,167,106,.72); box-shadow: 0 18px 42px rgba(31,33,29,.1); }
  .tn-blog-card:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-blog-meta { color: var(--tn-clay); font-size: 12px; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  .tn-blog-card h2 { margin: 18px 0 0; font-size: 26px; line-height: 1.08; font-weight: 950; letter-spacing: 0; overflow-wrap: anywhere; }
  .tn-blog-excerpt { margin: 16px 0 0; color: var(--tn-muted); font-size: 15px; line-height: 1.65; }
  .tn-blog-read { align-self: end; display: inline-flex; width: max-content; margin-top: 26px; padding-bottom: 3px; border-bottom: 2px solid var(--tn-gold); color: var(--tn-forest); font-size: 14px; font-weight: 950; }
  .tn-blog-empty { margin: 42px 0 78px; padding: 34px; border: 1px solid var(--tn-line); border-radius: 10px; background: var(--tn-cream); color: var(--tn-muted); font-size: 16px; line-height: 1.6; }

  @media (max-width: 980px) {
    .tn-blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .tn-blog-wrap { width: min(100% - 24px, 1180px); }
    .tn-blog-hero { padding: 48px 0 30px; }
    .tn-blog-title { font-size: 40px; line-height: 1.02; }
    .tn-blog-copy { font-size: 16px; }
    .tn-blog-grid { grid-template-columns: 1fr; gap: 14px; padding: 28px 0 54px; }
    .tn-blog-card { min-height: auto; padding: 22px; }
    .tn-blog-card h2 { font-size: 24px; }
  }
</style>

<section class="tn-blog">
  <div class="tn-blog-wrap">
    <header class="tn-blog-hero">
      <p class="tn-blog-kicker">TrailNest Guides</p>
      <h1 class="tn-blog-title">{{ blog.title | escape }}</h1>
      <p class="tn-blog-copy">Field notes for choosing, setting up, and enjoying inflatable camping tents for family camping, car camping, and glamping-style weekends.</p>
      <span class="tn-blog-count">{{ blog.articles_count }} articles</span>
    </header>

    {% paginate blog.articles by 12 %}
      {% if blog.articles.size > 0 %}
        <div class="tn-blog-grid">
          {% for article in blog.articles %}
            <a class="tn-blog-card" href="{{ article.url }}">
              <span class="tn-blog-meta">{{ article.published_at | date: "%b %d, %Y" }}</span>
              <h2>{{ article.title | escape }}</h2>
              <p class="tn-blog-excerpt">
                {% if article.excerpt != blank %}
                  {{ article.excerpt | strip_html | truncate: 180 }}
                {% else %}
                  {{ article.content | strip_html | truncate: 180 }}
                {% endif %}
              </p>
              <span class="tn-blog-read">Read guide</span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="tn-blog-empty">TrailNest guides are coming soon.</div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>
