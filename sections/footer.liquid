{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  .rs-footer {
    background: #142018;
    color: #fffaf0;
    border-top: 1px solid rgba(232, 220, 193, .18);
    padding: 64px 0 34px;
  }
  .rs-footer-wrap {
    width: min(1200px, calc(100% - 32px));
    margin: 0 auto;
  }
  .rs-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(150px, .7fr));
    gap: 34px;
  }
  .rs-footer h2 { margin: 0; font-size: 24px; font-weight: 950; letter-spacing: 0; }
  .rs-footer p { max-width: 420px; margin: 14px 0 0; color: #d8d0bd; line-height: 1.65; }
  .rs-footer h3 { margin: 0 0 14px; color: #d9b86f; font-size: 12px; font-weight: 950; text-transform: uppercase; letter-spacing: .12em; }
  .rs-footer a { display: block; margin-top: 10px; color: #d8d0bd; text-decoration: none; font-size: 14px; font-weight: 760; }
  .rs-footer a:hover { color: #fffaf0; }
  .rs-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgba(255,250,240,.1);
    color: #a79e89;
    font-size: 12px;
    font-weight: 800;
  }
  @media (max-width: 760px) {
    .rs-footer-grid { grid-template-columns: 1fr; }
    .rs-footer-bottom { flex-direction: column; }
  }
</style>

<footer class="rs-footer">
  <div class="rs-footer-wrap">
    <div class="rs-footer-grid">
      <div>
        <h2>TrailNest</h2>
        <p>Practical outdoor gear for travel, camping, and a warmer life outside.</p>
      </div>
      <div>
        <h3>Shop</h3>
        <a href="/collections/all">All Gear</a>
        <a href="/#trailnest-living">Outdoor Living</a>
        <a href="/cart">Cart</a>
      </div>
      <div>
        <h3>Brand</h3>
        <a href="/pages/about-trailnest">About TrailNest</a>
        <a href="/pages/contact">Contact</a>
        <a href="/policies/shipping-policy">Shipping</a>
      </div>
      <div>
        <h3>Support</h3>
        <a href="/policies/refund-policy">Returns</a>
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Terms</a>
      </div>
    </div>
    <div class="rs-footer-bottom">
      <span>© 2026 TrailNest</span>
      <span>Reliable essentials for the open-air life.</span>
    </div>
  </div>
</footer>