{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  .rs-footer {
    background: #030711;
    color: #f8fbff;
    border-top: 1px solid rgba(125, 211, 252, .16);
    padding: 64px 0 34px;
  }
  .rs-footer-wrap {
    width: min(1200px, calc(100% - 32px));
    margin: 0 auto;
  }
  .rs-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(150px, .7fr));
    gap: 34px;
  }
  .rs-footer h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 950;
    letter-spacing: 0;
  }
  .rs-footer p {
    max-width: 420px;
    margin: 14px 0 0;
    color: #9fb1c7;
    line-height: 1.65;
  }
  .rs-footer h3 {
    margin: 0 0 14px;
    color: #41f0b4;
    font-size: 12px;
    font-weight: 950;
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .rs-footer a {
    display: block;
    margin-top: 10px;
    color: #9fb1c7;
    text-decoration: none;
    font-size: 14px;
    font-weight: 760;
  }
  .rs-footer a:hover { color: #21d4fd; }
  .rs-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #64748b;
    font-size: 12px;
    font-weight: 800;
  }
  @media (max-width: 760px) {
    .rs-footer-grid { grid-template-columns: 1fr; }
    .rs-footer-bottom { flex-direction: column; }
  }
</style>

<footer class="rs-footer">
  <div class="rs-footer-wrap">
    <div class="rs-footer-grid">
      <div>
        <h2>1st Plunge Recovery</h2>
        <p>A home cold therapy system for athletes, lifters, runners, and recovery-focused training routines.</p>
      </div>
      <div>
        <h3>System</h3>
        <a href="/#recovery-tech">Technology</a>
        <a href="/products/1st-plunge-ice-bath-recovery-kit-premium-cold-therapy-system">Recovery Kit</a>
        <a href="/cart">Cart</a>
      </div>
      <div>
        <h3>Specs</h3>
        <a href="/#recovery-tech">42°F Cooling</a>
        <a href="/#recovery-tech">40dB Quiet</a>
        <a href="/#recovery-tech">148Gal Tub</a>
      </div>
      <div>
        <h3>Support</h3>
        <a href="/pages/contact">Contact</a>
        <a href="/policies/shipping-policy">Shipping</a>
        <a href="/policies/refund-policy">Returns</a>
      </div>
    </div>
    <div class="rs-footer-bottom">
      <span>© 2026 1st Plunge Recovery Systems</span>
      <span>Cold therapy equipment for home recovery.</span>
    </div>
  </div>
</footer>
