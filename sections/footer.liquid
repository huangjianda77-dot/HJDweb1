{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}

<style>
  .rs-footer { background: #182418; color: #fff8ea; border-top: 1px solid rgba(232, 220, 193, .18); padding: 64px 0 34px; }
  .rs-footer-wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .rs-footer-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(150px, .7fr)); gap: 34px; }
  .rs-footer h2 { margin: 0; font-size: 24px; font-weight: 950; letter-spacing: 0; }
  .rs-footer p { max-width: 420px; margin: 14px 0 0; color: #dcd2c1; line-height: 1.65; }
  .rs-footer h3 { margin: 0 0 14px; color: #d8b56d; font-size: 12px; font-weight: 950; text-transform: uppercase; letter-spacing: .12em; }
  .rs-footer a { display: block; margin-top: 10px; color: #dcd2c1; text-decoration: none; font-size: 14px; font-weight: 760; }
  .rs-footer a:hover { color: #fff8ea; }
  .rs-footer-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 48px; padding-top: 22px; border-top: 1px solid rgba(255,248,234,.1); color: #aa9f89; font-size: 12px; font-weight: 800; }
  @media (max-width: 760px) { .rs-footer { padding: 48px 0 28px; } .rs-footer-wrap { width: min(100% - 24px, 1200px); } .rs-footer-grid { grid-template-columns: 1fr; gap: 26px; } .rs-footer-bottom { flex-direction: column; margin-top: 34px; } }
</style>

<footer class="rs-footer"><div class="rs-footer-wrap"><div class="rs-footer-grid">
  <div><h2>{{ 'trailnest.brand.name' | t }}</h2><p>{{ 'trailnest.footer.tagline' | t }}</p></div>
  <div><h3>{{ 'trailnest.footer.shop' | t }}</h3><a href="/collections/all">{{ 'trailnest.footer.all_tents' | t }}</a><a href="/#tent-life">{{ 'trailnest.footer.camping_life' | t }}</a><a href="/cart">{{ 'trailnest.actions.cart' | t }}</a></div>
  <div><h3>{{ 'trailnest.footer.brand' | t }}</h3><a href="/pages/about-trailnest">{{ 'trailnest.footer.about' | t }}</a><a href="/pages/contact">{{ 'trailnest.footer.contact' | t }}</a><a href="/policies/shipping-policy">{{ 'trailnest.footer.shipping' | t }}</a></div>
  <div><h3>{{ 'trailnest.footer.support' | t }}</h3><a href="/policies/refund-policy">{{ 'trailnest.footer.returns' | t }}</a><a href="/policies/privacy-policy">{{ 'trailnest.footer.privacy' | t }}</a><a href="/policies/terms-of-service">{{ 'trailnest.footer.terms' | t }}</a></div>
</div><div class="rs-footer-bottom"><span>{{ 'trailnest.footer.copyright' | t }}</span><span>{{ 'trailnest.footer.bottom_note' | t }}</span></div></div></footer>