  .rs-footer-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 48px; padding-top: 22px; border-top: 1px solid rgba(255,248,234,.1); color: #aa9f89; font-size: 12px; font-weight: 800; }
