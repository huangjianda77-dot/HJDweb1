{% schema %}
{
  "name": "Product Details",
  "settings": [],
  "presets": [{ "name": "Product Details" }]
}
{% endschema %}

<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-20 items-center">
      <!-- Media -->
      <div class="relative order-2 lg:order-1">
        <div class="relative z-10 aspect-square rounded-[3rem] overflow-hidden shadow-2xl">
          <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&q=80&w=1200" class="w-full h-full object-cover">
        </div>
        <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50"></div>
        <div class="absolute -bottom-10 -right-10 w-60 h-60 bg-blue-200 rounded-full blur-3xl opacity-30"></div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2 mt-16 lg:mt-0">
        <h2 class="text-[11px] font-black tracking-[0.4em] text-blue-600 uppercase mb-4">The Flagship</h2>
        <h1 class="text-4xl md:text-5xl font-black text-zinc-900 mb-8 tracking-tighter leading-tight">ArcticPlunge Pro V2</h1>
        
        <div class="space-y-8 mb-12">
          <div class="flex items-start">
            <div class="mt-1 flex-shrink-0 w-6 h-6 bg-blue-600 text-white flex items-center justify-center rounded-full">
               <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="ml-4">
              <h4 class="text-base font-bold text-zinc-900 uppercase tracking-tighter">400L XL Capacity</h4>
              <p class="text-zinc-500 text-sm">Spacious enough for athletes up to 6'7" to fully submerge for optimal results.</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="mt-1 flex-shrink-0 w-6 h-6 bg-blue-600 text-white flex items-center justify-center rounded-full">
               <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="ml-4">
              <h4 class="text-base font-bold text-zinc-900 uppercase tracking-tighter">Military Rip-Stop Fabric</h4>
              <p class="text-zinc-500 text-sm">Industrial grade PVC that is puncture proof and built for outdoor longevity.</p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-zinc-100">
           <div class="flex-1">
             <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest mb-1 italic">Price</p>
             <p class="text-3xl font-black text-zinc-900">$299.00 USD</p>
           </div>
           <button class="px-12 py-5 bg-zinc-900 text-white font-bold uppercase tracking-[0.2em] text-xs hover:bg-blue-600 transition-all flex h-14 items-center justify-center">
             Add to Cart
           </button>
        </div>
      </div>
    </div>
  </div>
</section>
