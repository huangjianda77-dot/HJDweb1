<script>
  window.trailnestProductGallery = window.trailnestProductGallery || function(root) {
    var mainButton = root.querySelector('[data-tn-main-image]');
    var mainImg = root.querySelector('[data-tn-main-img]');
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-tn-thumb]'));
    var prev = root.querySelector('[data-tn-prev]');
    var next = root.querySelector('[data-tn-next]');
    var count = root.querySelector('[data-tn-count]');
    var zoom = document.querySelector('[data-tn-zoom]');
    var zoomImg = document.querySelector('[data-tn-zoom-img]');
    var zoomClose = document.querySelector('[data-tn-zoom-close]');
    var zoomPrev = document.querySelector('[data-tn-zoom-prev]');
    var zoomNext = document.querySelector('[data-tn-zoom-next]');
    var variantSelect = root.querySelector('[data-tn-variant-select]');
    var variantCards = Array.prototype.slice.call(root.querySelectorAll('[data-tn-variant-card]'));
    var variantJson = document.querySelector('[data-tn-variants-json]');
    var variants = [];
    try { variants = variantJson ? JSON.parse(variantJson.textContent) : []; } catch (error) { variants = []; }
    var selectedOption = root.querySelector('[data-tn-selected-option]');
    var price = root.querySelector('[data-tn-price]');
    var headerPrice = root.querySelector('[data-tn-buy-header-price]');
    var stickyPrice = root.querySelector('[data-tn-sticky-price]');
    var stock = root.querySelector('[data-tn-stock]');
    var sku = root.querySelector('[data-tn-sku]');
    var availability = root.querySelector('[data-tn-availability]');
    var addButton = root.querySelector('[data-tn-add]');
    var productForm = root.querySelector('.tn-product-form');
    var buyPanel = root.querySelector('[data-tn-buy-panel]');
    var buyOpeners = Array.prototype.slice.call(root.querySelectorAll('[data-tn-open-buy]'));
    var buyClose = root.querySelector('[data-tn-close-buy]');
    var activeIndex = Math.max(0, thumbs.findIndex(function(thumb) { return thumb.getAttribute('aria-current') === 'true'; }));
    if (window.matchMedia && window.matchMedia('(max-width: 720px)').matches && thumbs.length > 1) {
      activeIndex = 1;
    }
    var activeVariant = null;
    if (!mainButton || !mainImg || !thumbs.length || !zoom || !zoomImg || !zoomClose) return;
    var preloadedImages = {};
    function isOliveMedia(thumb) {
      return /olive/i.test(thumb.dataset.alt || '');
    }
    function variantImageIndexes(variant) {
      if (!variant) return thumbs.map(function(_, index) { return index; });
      var mediaIds = Array.isArray(variant.mediaIds) ? variant.mediaIds.map(String) : [];
      var indexes = [];
      if (mediaIds.length) {
        indexes = thumbs.reduce(function(acc, thumb, index) {
          if (mediaIds.indexOf(String(thumb.dataset.mediaId)) >= 0) acc.push(index);
          return acc;
        }, []);
      }
      if (!indexes.length && /olive/i.test(variant.title || '')) {
        var firstOliveIndex = thumbs.findIndex(isOliveMedia);
        if (firstOliveIndex >= 0) indexes = [firstOliveIndex];
      }
      if (!indexes.length && /beige/i.test(variant.title || '')) {
        var firstBeigeIndex = thumbs.findIndex(function(thumb) { return !isOliveMedia(thumb); });
        if (firstBeigeIndex >= 0) indexes = [firstBeigeIndex];
      }
      if (!indexes.length) indexes = thumbs.map(function(_, index) { return index; });
      return indexes.slice(0, 1);
    }
    function allImageIndexes() {
      return thumbs.map(function(_, index) { return index; });
    }
    function isBuyMode() {
      return root.classList.contains('tn-buy-mode');
    }
    function activeGalleryIndexes() {
      return isBuyMode() && activeVariant ? variantImageIndexes(activeVariant) : allImageIndexes();
    }
    function preloadImage(src) {
      if (!src || preloadedImages[src]) return;
      preloadedImages[src] = true;
      var image = new Image();
      image.decoding = 'async';
      image.src = src;
    }
    function preloadNearbyImages() {
      var indexes = activeGalleryIndexes();
      if (!indexes.length) return;
      var currentPosition = indexes.indexOf(activeIndex);
      if (currentPosition < 0) currentPosition = 0;
      [1, -1, 2].forEach(function(offset) {
        var targetIndex = indexes[(currentPosition + offset + indexes.length) % indexes.length];
        var thumb = thumbs[targetIndex];
        if (thumb) preloadImage(thumb.dataset.fullSrc);
      });
      variantCards.forEach(function(card) {
        preloadImage(card.dataset.variantImageSrc);
      });
    }
    function schedulePreload() {
      var run = preloadNearbyImages;
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 1200 });
      } else {
        window.setTimeout(run, 350);
      }
    }
    function setMainSource(src, zoomSrc, alt) {
      if (!src) return;
      if (mainImg.getAttribute('src') !== src) {
        mainImg.decoding = 'async';
        mainImg.src = src;
      }
      mainImg.dataset.zoomSrc = zoomSrc || src;
      mainImg.alt = alt || '';
      mainButton.setAttribute('aria-label', 'Open ' + (alt || 'product image'));
    }
    function syncVariantThumbs() {
      var indexes = activeGalleryIndexes();
      var shouldFilter = isBuyMode() && activeVariant;
      root.classList.toggle('tn-single-sku-image', shouldFilter && indexes.length <= 1);
      thumbs.forEach(function(thumb, index) {
        var shouldHide = shouldFilter && indexes.indexOf(index) < 0;
        thumb.hidden = shouldHide;
        thumb.classList.toggle('is-hidden', shouldHide);
        if (shouldHide) {
          thumb.setAttribute('aria-hidden', 'true');
        } else {
          thumb.removeAttribute('aria-hidden');
        }
      });
    }
    function scopedShow(direction) {
      var indexes = activeGalleryIndexes();
      var currentPosition = indexes.indexOf(activeIndex);
      if (currentPosition < 0) currentPosition = 0;
      show(indexes[(currentPosition + direction + indexes.length) % indexes.length]);
    }
    function show(index) {
      activeIndex = (index + thumbs.length) % thumbs.length;
      var thumb = thumbs[activeIndex];
      setMainSource(thumb.dataset.fullSrc, thumb.dataset.zoomSrc, thumb.dataset.alt || '');
      syncVariantThumbs();
      thumbs.forEach(function(t, i) { t.setAttribute('aria-current', i === activeIndex ? 'true' : 'false'); });
      if (thumb.scrollIntoView) thumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'auto' });
      if (count) count.textContent = (activeIndex + 1) + ' / ' + thumbs.length;
      if (zoom.classList.contains('is-open')) { zoomImg.src = thumb.dataset.zoomSrc || thumb.dataset.fullSrc; zoomImg.alt = thumb.dataset.alt || ''; }
      schedulePreload();
    }
    function showVariantCardImage(card) {
      if (!card || !card.dataset.variantImageSrc) return false;
      setMainSource(card.dataset.variantImageSrc, card.dataset.variantImageZoom || card.dataset.variantImageSrc, card.dataset.variantImageAlt || '');
      thumbs.forEach(function(t) { t.setAttribute('aria-current', 'false'); });
      if (count) count.textContent = 'SKU';
      if (zoom.classList.contains('is-open')) {
        zoomImg.src = mainImg.dataset.zoomSrc || mainImg.src;
        zoomImg.alt = mainImg.alt || '';
      }
      schedulePreload();
      return true;
    }
    thumbs.forEach(function(thumb, index) { thumb.addEventListener('click', function() { show(index); }); });
    if (prev) prev.addEventListener('click', function() { scopedShow(-1); });
    if (next) next.addEventListener('click', function() { scopedShow(1); });
    var touchStartX = 0;
    var touchStartY = 0;
    var touchStartedAt = 0;
    mainButton.addEventListener('touchstart', function(event) {
      if (!event.touches || event.touches.length !== 1) return;
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
      touchStartedAt = Date.now();
    }, { passive: true });
    mainButton.addEventListener('touchend', function(event) {
      if (!event.changedTouches || event.changedTouches.length !== 1) return;
      var dx = event.changedTouches[0].clientX - touchStartX;
      var dy = event.changedTouches[0].clientY - touchStartY;
      var isHorizontalSwipe = Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy) * 1.35;
      if (!isHorizontalSwipe) return;
      if (Date.now() - touchStartedAt > 900) return;
      event.preventDefault();
      scopedShow(dx < 0 ? 1 : -1);
    }, { passive: false });
    function stockText(variant) {
      if (!variant || !variant.available) return 'Currently unavailable';
      return variant.inventoryManaged ? 'In stock: ' + variant.inventoryQuantity + ' available' : 'In stock';
    }
    function chooseVariant(variantId, options) {
      options = options || {};
      var variant = variants.find(function(item) { return String(item.id) === String(variantId); });
      if (!variant) return;
      if (variantSelect) {
        variantSelect.value = variant.id;
        variantSelect.dispatchEvent(new Event('input', { bubbles: true }));
      }
      variantCards.forEach(function(card) { card.setAttribute('aria-pressed', String(card.dataset.variantId) === String(variant.id) ? 'true' : 'false'); });
      var selectedCard = variantCards.find(function(card) { return String(card.dataset.variantId) === String(variant.id); });
      if (selectedCard && selectedCard.scrollIntoView) selectedCard.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'auto' });
      if (window.history && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      }
      if (selectedOption) selectedOption.textContent = variant.title || '';
      if (price) price.textContent = variant.price || '';
      if (headerPrice) headerPrice.textContent = variant.price || '';
      if (stickyPrice) stickyPrice.textContent = variant.price || '';
      if (stock) stock.textContent = stockText(variant);
      if (sku) sku.textContent = variant.sku || 'TrailNest Tent';
      if (availability) availability.textContent = variant.available ? 'In stock' : 'Sold out';
      if (addButton) { addButton.disabled = !variant.available; addButton.textContent = variant.available ? 'Add to cart' : 'Sold out'; }
      activeVariant = variant;
      syncVariantThumbs();
      if (options.updateGallery !== false) {
        if (showVariantCardImage(options.variantCard || selectedCard)) return;
        var variantIndexes = variantImageIndexes(variant);
        var targetIndex = variantIndexes.length ? variantIndexes[0] : activeIndex;
        show(targetIndex);
      }
    }
    variantCards.forEach(function(card) { card.addEventListener('click', function() { chooseVariant(card.dataset.variantId, { updateGallery: true, variantCard: card }); }); });
    if (variantSelect) variantSelect.addEventListener('change', function() { chooseVariant(variantSelect.value, { updateGallery: true }); });
    if (variantSelect && variantSelect.value) chooseVariant(variantSelect.value, { updateGallery: false });
    function setBuyMode(enabled, shouldScroll) {
      root.classList.toggle('tn-buy-mode', enabled);
      var indexes = activeGalleryIndexes();
      if (enabled && indexes.indexOf(activeIndex) < 0) {
        show(indexes[0]);
      } else {
        show(activeIndex);
      }
      if (shouldScroll) {
        var target = root;
        if (target && target.scrollIntoView) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    function openBuyFlow(event) {
      if (event) event.preventDefault();
      if (root.classList.contains('tn-buy-mode') && event && event.currentTarget && event.currentTarget.classList.contains('tn-sticky-buy')) {
        if (productForm && productForm.requestSubmit) {
          if (addButton) productForm.requestSubmit(addButton);
          else productForm.requestSubmit();
        } else if (addButton) {
          addButton.click();
        }
        return;
      }
      setBuyMode(true, true);
      if (window.history && window.history.pushState) {
        window.history.pushState({}, '', '#trailnest-buy');
      } else {
        window.location.hash = 'trailnest-buy';
      }
    }
    function closeBuyFlow(event) {
      if (event) event.preventDefault();
      setBuyMode(false, true);
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, '', window.location.pathname + window.location.search);
      }
    }
    buyOpeners.forEach(function(link) { link.addEventListener('click', openBuyFlow); });
    if (buyClose) buyClose.addEventListener('click', closeBuyFlow);
    window.addEventListener('hashchange', function() { setBuyMode(window.location.hash === '#trailnest-buy', false); });
    setBuyMode(window.location.hash === '#trailnest-buy', false);
    function openZoom() { var thumb = thumbs[activeIndex]; zoomImg.src = thumb.dataset.zoomSrc || mainImg.src; zoomImg.alt = mainImg.alt || ''; zoom.classList.add('is-open'); zoom.setAttribute('aria-hidden','false'); document.documentElement.style.overflow = 'hidden'; zoomClose.focus(); }
    function closeZoom() { zoom.classList.remove('is-open'); zoom.setAttribute('aria-hidden','true'); zoomImg.src = ''; document.documentElement.style.overflow = ''; mainButton.focus(); }
    mainButton.addEventListener('click', openZoom);
    zoomClose.addEventListener('click', closeZoom);
    if (zoomPrev) zoomPrev.addEventListener('click', function(e) { e.stopPropagation(); scopedShow(-1); });
    if (zoomNext) zoomNext.addEventListener('click', function(e) { e.stopPropagation(); scopedShow(1); });
    zoom.addEventListener('click', function(event) { if (event.target === zoom) closeZoom(); });
    document.addEventListener('keydown', function(event) { if (event.key === 'Escape' && zoom.classList.contains('is-open')) closeZoom(); if (event.key === 'ArrowLeft' && zoom.classList.contains('is-open')) scopedShow(-1); if (event.key === 'ArrowRight' && zoom.classList.contains('is-open')) scopedShow(1); });
    show(activeIndex);
  };
  document.querySelectorAll('[data-tn-gallery-root]').forEach(window.trailnestProductGallery);
</script>
