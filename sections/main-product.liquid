{% schema %}
{
  "name": "Product Details",
  "settings": [],
  "presets": [{ "name": "Product Details" }]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} { --tn-forest:#182418; --tn-paper:#fff8ea; --tn-ink:#20261f; --tn-muted:#6c705f; --tn-line:rgba(32,38,31,.14); --tn-gold:#d8b56d; --tn-clay:#a96945; background: var(--tn-paper); color: var(--tn-ink); }
  .tn-product * { box-sizing: border-box; }
  .tn-product { background: var(--tn-paper); }
  .tn-product-wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .tn-product-hero { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr); gap: 48px; align-items: start; padding: 72px 0 64px; }
  .tn-product-gallery { position: relative; display: block; padding-left: 106px; }
  .tn-product-thumbs { position: absolute; left: 0; top: 0; bottom: 0; width: 92px; display: grid; align-content: start; gap: 10px; overflow-y: auto; padding-right: 4px; scrollbar-width: thin; }
  .tn-product-thumb-button { overflow: hidden; display: block; width: 100%; padding: 0; border: 2px solid transparent; border-radius: 6px; background: #fff; cursor: pointer; }
  .tn-product-thumb-button[aria-current="true"] { border-color: var(--tn-gold); }
  .tn-product-thumb-button[hidden] { display: none; }
  .tn-product-thumb-button.is-hidden { display: none !important; }
  .tn-product-thumb-button:focus-visible { outline: 3px solid var(--tn-forest); outline-offset: 2px; }
  .tn-product-thumb-button img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .tn-product-stage { position: relative; display: block; align-self: start; }
  .tn-product-main-wrap { position: relative; }
  .tn-product-main-image { position: relative; overflow: hidden; display: block; width: 100%; padding: 0; border: 1px solid rgba(32,38,31,.08); border-radius: 8px; background: #fff; box-shadow: 0 22px 54px rgba(31,38,31,.08); cursor: zoom-in; touch-action: pan-y; }
  .tn-product-main-image img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .tn-product-main-image:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-product-zoom-hint { position: absolute; right: 12px; bottom: 12px; min-height: 34px; display: inline-flex; align-items: center; padding: 0 12px; border-radius: 999px; background: rgba(24,36,24,.82); color: var(--tn-paper); font-size: 12px; font-weight: 900; pointer-events: none; }
  .tn-gallery-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid rgba(32,38,31,.14); border-radius: 999px; background: rgba(255,255,255,.88); color: var(--tn-forest); font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 10px 28px rgba(31,38,31,.14); }
  .tn-gallery-nav:hover { background: #fff; }
  .tn-gallery-nav:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 2px; }
  .tn-gallery-prev { left: 12px; }
  .tn-gallery-next { right: 12px; }
  .tn-gallery-count { position: absolute; top: 12px; left: 50%; z-index: 3; min-height: 28px; display: inline-flex; align-items: center; transform: translateX(-50%); padding: 0 10px; border-radius: 999px; background: rgba(255,255,255,.86); color: var(--tn-forest); font-size: 12px; font-weight: 900; box-shadow: 0 8px 20px rgba(31,38,31,.12); pointer-events: none; }
  .tn-product-zoom { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; padding: 28px; background: rgba(15,20,15,.9); }
  .tn-product-zoom.is-open { display: flex; }
  .tn-product-zoom img { display: block; max-width: min(1180px, 94vw); max-height: 88vh; object-fit: contain; border-radius: 8px; background: #fff; box-shadow: 0 24px 80px rgba(0,0,0,.38); }
  .tn-product-zoom-close, .tn-zoom-nav { position: absolute; border: 1px solid rgba(255,248,234,.32); border-radius: 999px; background: rgba(255,248,234,.12); color: #fff8ea; cursor: pointer; }
  .tn-product-zoom-close { top: 18px; right: 18px; width: 44px; height: 44px; font-size: 28px; line-height: 1; }
  .tn-zoom-nav { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; display: grid; place-items: center; font-size: 30px; }
  .tn-zoom-prev { left: 18px; }
  .tn-zoom-next { right: 18px; }
  .tn-product-info { position: sticky; top: 92px; padding: 34px; border: 1px solid rgba(32,38,31,.12); border-radius: 8px; background: rgba(255,255,255,.72); box-shadow: 0 18px 48px rgba(31,38,31,.06); }
  .tn-product-kicker { margin: 0 0 12px; color: var(--tn-clay); font-size: 12px; font-weight: 950; letter-spacing: .14em; text-transform: uppercase; }
  .tn-product-title { margin: 0; font-size: 46px; line-height: 1.04; font-weight: 950; letter-spacing: 0; }
  .tn-product-summary { margin: 18px 0 0; color: var(--tn-muted); font-size: 17px; line-height: 1.65; }
  .tn-hero-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .tn-hero-facts li { min-height: 42px; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid rgba(32,38,31,.1); border-radius: 8px; background: rgba(255,255,255,.62); color: var(--tn-ink); font-size: 13px; line-height: 1.25; font-weight: 900; }
  .tn-hero-facts li::before { content: ""; width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--tn-gold); box-shadow: 0 0 0 4px rgba(216,181,109,.16); }
  .tn-product-buy-link { display: none; align-items: center; justify-content: center; width: 100%; min-height: 54px; margin-top: 22px; border-radius: 999px; background: var(--tn-forest); color: var(--tn-paper); font-size: 15px; font-weight: 950; letter-spacing: .02em; text-decoration: none; }
  .tn-product-buy-link:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-buy-back { display: none; width: max-content; margin-bottom: 14px; color: var(--tn-forest); font-size: 13px; font-weight: 900; text-decoration: none; }
  .tn-buy-back:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-buy-mobile-header { display: none; }
  .tn-buy-mobile-title { margin: 0; font-size: 28px; line-height: 1.08; font-weight: 950; letter-spacing: 0; }
  .tn-buy-mobile-price, .tn-buy-service-strip { display: none; }
  .tn-product-points { display: grid; gap: 12px; margin: 28px 0; padding: 0; list-style: none; }
  .tn-product-points li { display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: start; color: var(--tn-ink); font-weight: 850; line-height: 1.45; }
  .tn-product-points li::before { content: ""; width: 22px; height: 22px; border-radius: 50%; background: var(--tn-gold); box-shadow: inset 0 0 0 7px rgba(24,36,24,.12); }
  .tn-product-price { margin: 28px 0 0; padding-top: 24px; border-top: 1px solid var(--tn-line); }
  .tn-product-price-label { display: block; margin-bottom: 4px; color: var(--tn-muted); font-size: 11px; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  .tn-product-price-value { font-size: 34px; line-height: 1; font-weight: 950; }
  .tn-price-note { margin: 8px 0 0; color: var(--tn-muted); font-size: 13px; line-height: 1.45; font-weight: 850; }
  .tn-product-form { display: grid; gap: 14px; margin-top: 22px; }
  .tn-product-select { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tn-product-qty { width: 100%; min-height: 48px; border: 1px solid var(--tn-line); border-radius: 4px; background: #fff; color: var(--tn-ink); padding: 0 12px; font-size: 15px; font-weight: 800; }
  .tn-variant-fieldset { margin: 0; padding: 0; border: 0; }
  .tn-variant-label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; color: var(--tn-muted); font-size: 13px; font-weight: 900; letter-spacing: 0; text-transform: none; }
  .tn-variant-label span { color: var(--tn-ink); font-size: 18px; font-weight: 950; }
  .tn-variant-label strong { color: var(--tn-muted); font-size: 13px; letter-spacing: 0; text-transform: none; }
  .tn-variant-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tn-variant-card { position: relative; min-height: 104px; padding: 16px; border: 2px solid rgba(32,38,31,.18); border-radius: 10px; background: #fff; color: var(--tn-ink); text-align: left; cursor: pointer; box-shadow: 0 10px 24px rgba(31,38,31,.04); transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease; }
  .tn-variant-card:hover { border-color: rgba(216,181,109,.9); box-shadow: 0 14px 30px rgba(31,38,31,.08); transform: translateY(-1px); }
  .tn-variant-card[aria-pressed="true"] { border-color: var(--tn-forest); box-shadow: 0 0 0 3px rgba(216,181,109,.42), 0 14px 30px rgba(31,38,31,.08); }
  .tn-variant-card[aria-pressed="true"]::after { content: "Selected"; position: absolute; top: 12px; right: 14px; color: var(--tn-forest); font-size: 11px; font-weight: 950; }
  .tn-variant-card[disabled] { opacity: .48; cursor: not-allowed; transform: none; }
  .tn-variant-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tn-variant-name { font-size: 15px; font-weight: 950; line-height: 1.2; }
  .tn-variant-dot { width: 24px; height: 24px; flex: 0 0 24px; border: 1px solid rgba(32,38,31,.18); border-radius: 50%; background: var(--variant-color, #e8d8bf); box-shadow: inset 0 0 0 4px #fff; }
  .tn-variant-meta { display: grid; gap: 4px; margin-top: 12px; color: var(--tn-muted); font-size: 12px; font-weight: 800; line-height: 1.35; }
  .tn-variant-meta b { color: var(--tn-ink); font-weight: 950; }
  .tn-variant-status { color: #446044; }
  .tn-variant-card[disabled] .tn-variant-status { color: #9a3e2c; }
  .tn-product-row { display: grid; grid-template-columns: 1fr 110px; gap: 10px; }
  .tn-product-add { min-height: 54px; border: 0; border-radius: 4px; background: var(--tn-forest); color: var(--tn-paper); font-size: 14px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .tn-product-add[disabled] { opacity: .45; cursor: not-allowed; }
  .tn-product-stock { margin: 10px 0 0; color: var(--tn-muted); font-size: 13px; font-weight: 850; }
  .tn-product-trust { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
  .tn-product-trust span { min-height: 34px; display: inline-flex; align-items: center; gap: 8px; padding: 0 10px; border: 1px solid rgba(32,38,31,.1); border-radius: 999px; background: rgba(255,255,255,.72); color: var(--tn-muted); font-size: 12px; font-weight: 900; }
  .tn-product-trust span::before { content: ""; width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: var(--tn-gold); box-shadow: 0 0 0 4px rgba(216,181,109,.18); }
  .tn-buy-clarity { display: grid; gap: 10px; margin-top: 14px; padding: 16px; border: 1px solid rgba(32,38,31,.12); border-radius: 8px; background: rgba(255,248,234,.62); }
  .tn-buy-clarity-title { margin: 0; color: var(--tn-ink); font-size: 13px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; }
  .tn-buy-clarity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; margin: 0; padding: 0; list-style: none; }
  .tn-buy-clarity-grid li { display: grid; gap: 2px; min-width: 0; }
  .tn-buy-clarity-grid span { color: var(--tn-muted); font-size: 11px; font-weight: 900; text-transform: uppercase; }
  .tn-buy-clarity-grid b { color: var(--tn-ink); font-size: 13px; line-height: 1.32; font-weight: 950; }
  .tn-sticky-buy { display: none; }
  .tn-product-body { padding: 10px 0 86px; }
  .tn-product-body-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 24px; align-items: start; }
  .tn-product-panel { padding: 28px; border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; }
  .tn-product-panel h2, .tn-product-panel h3 { margin: 0 0 14px; font-size: 28px; line-height: 1.12; font-weight: 950; }
  .tn-product-panel p { margin: 0; }
  .tn-product-panel p + p { margin-top: 12px; }
  .tn-product-description { color: var(--tn-muted); font-size: 16px; line-height: 1.72; }
  .tn-product-description h3 { color: var(--tn-ink); font-size: 22px; }
  .tn-product-description ul { padding-left: 20px; }
  .tn-product-section-title { margin: 0 0 16px; font-size: 36px; line-height: 1.08; font-weight: 950; }
  .tn-product-section-copy { margin: 0; color: var(--tn-muted); font-size: 17px; line-height: 1.72; }
  .tn-product-proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
  .tn-product-proof { padding: 16px; border: 1px solid rgba(32,38,31,.1); border-radius: 8px; background: rgba(255,248,234,.55); }
  .tn-product-proof b { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 950; }
  .tn-product-proof span { color: var(--tn-muted); font-size: 13px; line-height: 1.45; font-weight: 750; }
  .tn-value-stack { display: grid; gap: 10px; margin-top: 18px; }
  .tn-value-item { display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: start; padding: 14px; border: 1px solid rgba(32,38,31,.1); border-radius: 8px; background: rgba(255,248,234,.55); }
  .tn-value-item span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--tn-forest); color: var(--tn-paper); font-size: 13px; font-weight: 950; }
  .tn-value-item b { display: block; margin-bottom: 4px; color: var(--tn-ink); font-size: 14px; font-weight: 950; }
  .tn-value-item p { color: var(--tn-muted); font-size: 14px; line-height: 1.55; font-weight: 750; }
  .tn-product-specs { display: grid; gap: 12px; }
  .tn-product-spec { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(32,38,31,.1); }
  .tn-product-spec:last-child { border-bottom: 0; }
