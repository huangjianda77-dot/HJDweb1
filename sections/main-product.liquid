{% schema %}
{
  "name": "Product Details",
  "settings": [],
  "presets": [{ "name": "Product Details" }]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} { --tn-forest:#182418; --tn-paper:#fff8ea; --tn-ink:#20261f; --tn-muted:#6c705f; --tn-line:rgba(32,38,31,.14); --tn-gold:#d8b56d; --tn-clay:#a96945; background: var(--tn-paper); color: var(--tn-ink); }
  .tn-product * { box-sizing: border-box; }
  .tn-product { background: var(--tn-paper); }
  .tn-product-wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .tn-product-hero { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr); gap: 48px; align-items: start; padding: 72px 0 64px; }
  .tn-product-gallery { position: relative; display: block; padding-left: 106px; }
  .tn-product-thumbs { position: absolute; left: 0; top: 0; bottom: 0; width: 92px; display: grid; align-content: start; gap: 10px; overflow-y: auto; padding-right: 4px; scrollbar-width: thin; }
  .tn-product-thumb-button { overflow: hidden; display: block; width: 100%; padding: 0; border: 2px solid transparent; border-radius: 6px; background: #fff; cursor: pointer; }
  .tn-product-thumb-button[aria-current="true"] { border-color: var(--tn-gold); }
  .tn-product-thumb-button[hidden] { display: none; }
  .tn-product-thumb-button.is-hidden { display: none !important; }
  .tn-product-thumb-button:focus-visible { outline: 3px solid var(--tn-forest); outline-offset: 2px; }
  .tn-product-thumb-button img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .tn-product-stage { position: relative; display: block; align-self: start; }
  .tn-product-main-wrap { position: relative; }
  .tn-product-main-image { position: relative; overflow: hidden; display: block; width: 100%; padding: 0; border: 1px solid rgba(32,38,31,.08); border-radius: 8px; background: #fff; box-shadow: 0 22px 54px rgba(31,38,31,.08); cursor: zoom-in; touch-action: pan-y; }
  .tn-product-main-image img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .tn-product-main-image:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-product-zoom-hint { position: absolute; right: 12px; bottom: 12px; min-height: 34px; display: inline-flex; align-items: center; padding: 0 12px; border-radius: 999px; background: rgba(24,36,24,.82); color: var(--tn-paper); font-size: 12px; font-weight: 900; pointer-events: none; }
  .tn-gallery-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid rgba(32,38,31,.14); border-radius: 999px; background: rgba(255,255,255,.88); color: var(--tn-forest); font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 10px 28px rgba(31,38,31,.14); }
  .tn-gallery-nav:hover { background: #fff; }
  .tn-gallery-nav:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 2px; }
  .tn-gallery-prev { left: 12px; }
  .tn-gallery-next { right: 12px; }
  .tn-gallery-count { position: absolute; top: 12px; left: 50%; z-index: 3; min-height: 28px; display: inline-flex; align-items: center; transform: translateX(-50%); padding: 0 10px; border-radius: 999px; background: rgba(255,255,255,.86); color: var(--tn-forest); font-size: 12px; font-weight: 900; box-shadow: 0 8px 20px rgba(31,38,31,.12); pointer-events: none; }
  .tn-product-zoom { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; padding: 28px; background: rgba(15,20,15,.9); }
  .tn-product-zoom.is-open { display: flex; }
  .tn-product-zoom img { display: block; max-width: min(1180px, 94vw); max-height: 88vh; object-fit: contain; border-radius: 8px; background: #fff; box-shadow: 0 24px 80px rgba(0,0,0,.38); }
  .tn-product-zoom-close, .tn-zoom-nav { position: absolute; border: 1px solid rgba(255,248,234,.32); border-radius: 999px; background: rgba(255,248,234,.12); color: #fff8ea; cursor: pointer; }
  .tn-product-zoom-close { top: 18px; right: 18px; width: 44px; height: 44px; font-size: 28px; line-height: 1; }
  .tn-zoom-nav { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; display: grid; place-items: center; font-size: 30px; }
  .tn-zoom-prev { left: 18px; }
  .tn-zoom-next { right: 18px; }
  .tn-product-info { position: sticky; top: 92px; padding: 34px; border: 1px solid rgba(32,38,31,.12); border-radius: 8px; background: rgba(255,255,255,.72); box-shadow: 0 18px 48px rgba(31,38,31,.06); }
  .tn-product-kicker { margin: 0 0 12px; color: var(--tn-clay); font-size: 12px; font-weight: 950; letter-spacing: .14em; text-transform: uppercase; }
  .tn-product-title { margin: 0; font-size: 46px; line-height: 1.04; font-weight: 950; letter-spacing: 0; }
  .tn-product-summary { margin: 18px 0 0; color: var(--tn-muted); font-size: 17px; line-height: 1.65; }
  .tn-product-buy-link { display: none; align-items: center; justify-content: center; width: 100%; min-height: 54px; margin-top: 22px; border-radius: 999px; background: var(--tn-forest); color: var(--tn-paper); font-size: 15px; font-weight: 950; letter-spacing: .02em; text-decoration: none; }
  .tn-product-buy-link:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-buy-back { display: none; width: max-content; margin-bottom: 14px; color: var(--tn-forest); font-size: 13px; font-weight: 900; text-decoration: none; }
  .tn-buy-back:focus-visible { outline: 3px solid var(--tn-gold); outline-offset: 3px; }
  .tn-buy-mobile-header { display: none; }
  .tn-buy-mobile-title { margin: 0; font-size: 28px; line-height: 1.08; font-weight: 950; letter-spacing: 0; }
  .tn-buy-mobile-price, .tn-buy-service-strip { display: none; }
  .tn-product-points { display: grid; gap: 12px; margin: 28px 0; padding: 0; list-style: none; }
  .tn-product-points li { display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: start; color: var(--tn-ink); font-weight: 850; line-height: 1.45; }
  .tn-product-points li::before { content: ""; width: 22px; height: 22px; border-radius: 50%; background: var(--tn-gold); box-shadow: inset 0 0 0 7px rgba(24,36,24,.12); }
  .tn-product-price { margin: 28px 0 0; padding-top: 24px; border-top: 1px solid var(--tn-line); }
  .tn-product-price-label { display: block; margin-bottom: 4px; color: var(--tn-muted); font-size: 11px; font-weight: 950; letter-spacing: .12em; text-transform: uppercase; }
  .tn-product-price-value { font-size: 34px; line-height: 1; font-weight: 950; }
  .tn-product-form { display: grid; gap: 14px; margin-top: 22px; }
  .tn-product-select { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tn-product-qty { width: 100%; min-height: 48px; border: 1px solid var(--tn-line); border-radius: 4px; background: #fff; color: var(--tn-ink); padding: 0 12px; font-size: 15px; font-weight: 800; }
  .tn-variant-fieldset { margin: 0; padding: 0; border: 0; }
  .tn-variant-label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; color: var(--tn-muted); font-size: 13px; font-weight: 900; letter-spacing: 0; text-transform: none; }
  .tn-variant-label span { color: var(--tn-ink); font-size: 18px; font-weight: 950; }
  .tn-variant-label strong { color: var(--tn-muted); font-size: 13px; letter-spacing: 0; text-transform: none; }
  .tn-variant-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tn-variant-card { position: relative; min-height: 104px; padding: 16px; border: 2px solid rgba(32,38,31,.18); border-radius: 10px; background: #fff; color: var(--tn-ink); text-align: left; cursor: pointer; box-shadow: 0 10px 24px rgba(31,38,31,.04); transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease; }
  .tn-variant-card:hover { border-color: rgba(216,181,109,.9); box-shadow: 0 14px 30px rgba(31,38,31,.08); transform: translateY(-1px); }
  .tn-variant-card[aria-pressed="true"] { border-color: var(--tn-forest); box-shadow: 0 0 0 3px rgba(216,181,109,.42), 0 14px 30px rgba(31,38,31,.08); }
  .tn-variant-card[aria-pressed="true"]::after { content: "Selected"; position: absolute; top: 12px; right: 14px; color: var(--tn-forest); font-size: 11px; font-weight: 950; }
  .tn-variant-card[disabled] { opacity: .48; cursor: not-allowed; transform: none; }
  .tn-variant-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tn-variant-name { font-size: 15px; font-weight: 950; line-height: 1.2; }
  .tn-variant-dot { width: 24px; height: 24px; flex: 0 0 24px; border: 1px solid rgba(32,38,31,.18); border-radius: 50%; background: var(--variant-color, #e8d8bf); box-shadow: inset 0 0 0 4px #fff; }
  .tn-variant-meta { display: grid; gap: 4px; margin-top: 12px; color: var(--tn-muted); font-size: 12px; font-weight: 800; line-height: 1.35; }
  .tn-variant-meta b { color: var(--tn-ink); font-weight: 950; }
  .tn-variant-status { color: #446044; }
  .tn-variant-card[disabled] .tn-variant-status { color: #9a3e2c; }
  .tn-product-row { display: grid; grid-template-columns: 1fr 110px; gap: 10px; }
  .tn-product-add { min-height: 54px; border: 0; border-radius: 4px; background: var(--tn-forest); color: var(--tn-paper); font-size: 14px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .tn-product-add[disabled] { opacity: .45; cursor: not-allowed; }
  .tn-product-stock { margin: 10px 0 0; color: var(--tn-muted); font-size: 13px; font-weight: 850; }
  .tn-product-trust { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
  .tn-product-trust span { min-height: 34px; display: inline-flex; align-items: center; gap: 8px; padding: 0 10px; border: 1px solid rgba(32,38,31,.1); border-radius: 999px; background: rgba(255,255,255,.72); color: var(--tn-muted); font-size: 12px; font-weight: 900; }
  .tn-product-trust span::before { content: ""; width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: var(--tn-gold); box-shadow: 0 0 0 4px rgba(216,181,109,.18); }
  .tn-product-body { padding: 10px 0 86px; }
  .tn-product-body-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 24px; align-items: start; }
  .tn-product-panel { padding: 28px; border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; }
  .tn-product-panel h2, .tn-product-panel h3 { margin: 0 0 14px; font-size: 28px; line-height: 1.12; font-weight: 950; }
  .tn-product-panel p { margin: 0; }
  .tn-product-panel p + p { margin-top: 12px; }
  .tn-product-description { color: var(--tn-muted); font-size: 16px; line-height: 1.72; }
  .tn-product-description h3 { color: var(--tn-ink); font-size: 22px; }
  .tn-product-description ul { padding-left: 20px; }
  .tn-product-section-title { margin: 0 0 16px; font-size: 36px; line-height: 1.08; font-weight: 950; }
  .tn-product-section-copy { margin: 0; color: var(--tn-muted); font-size: 17px; line-height: 1.72; }
  .tn-product-proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
  .tn-product-proof { padding: 16px; border: 1px solid rgba(32,38,31,.1); border-radius: 8px; background: rgba(255,248,234,.55); }
  .tn-product-proof b { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 950; }
  .tn-product-proof span { color: var(--tn-muted); font-size: 13px; line-height: 1.45; font-weight: 750; }
  .tn-product-specs { display: grid; gap: 12px; }
  .tn-product-spec { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid rgba(32,38,31,.1); }
  .tn-product-spec:last-child { border-bottom: 0; }
  .tn-product-spec span { color: var(--tn-muted); font-weight: 800; }
  .tn-product-spec b { text-align: right; }
  .tn-product-included { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .tn-product-included li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; color: var(--tn-muted); font-size: 15px; line-height: 1.45; font-weight: 800; }
  .tn-product-included li::before { content: ""; width: 10px; height: 10px; margin-top: 6px; border-radius: 50%; background: var(--tn-gold); }
  .tn-product-faq { display: grid; gap: 10px; margin-top: 24px; }
  .tn-product-faq details { border: 1px solid var(--tn-line); border-radius: 8px; background: #fff; }
  .tn-product-faq summary { cursor: pointer; padding: 16px 18px; color: var(--tn-ink); font-weight: 950; list-style: none; }
  .tn-product-faq summary::-webkit-details-marker { display: none; }
  .tn-product-faq summary::after { content: "+"; float: right; color: var(--tn-muted); font-weight: 950; }
  .tn-product-faq details[open] summary::after { content: "-"; }
  .tn-product-faq p { margin: 0; padding: 0 18px 18px; color: var(--tn-muted); font-size: 15px; line-height: 1.62; }
  @media (max-width: 960px) { .tn-product-hero, .tn-product-body-grid { grid-template-columns: 1fr; } .tn-product-info { position: static; } .tn-product-title { font-size: 38px; } }
  @media (max-width: 760px) { .tn-product-proof-grid { grid-template-columns: 1fr; } .tn-product-section-title { font-size: 30px; } }
  @media (max-width: 720px) { .tn-product-gallery { display: grid; grid-template-columns: 1fr; padding-left: 0; } .tn-product-stage { order: 1; } .tn-product-thumbs { position: static; order: 2; width: auto; max-height: none; display: flex; gap: 12px; overflow-x: auto; overflow-y: hidden; padding: 2px 0 8px; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; } .tn-product-thumb-button { width: 78px; flex: 0 0 78px; scroll-snap-align: start; } }
  @media (max-width: 620px) { .tn-product-wrap { width: min(100% - 24px, 1200px); } .tn-product-hero { padding: 30px 0 42px; gap: 22px; } .tn-product-info { display: flex; flex-direction: column; padding: 22px; } .tn-product-kicker { order: 1; } .tn-product-title { order: 2; font-size: 31px; } .tn-product-summary { order: 3; font-size: 15px; } .tn-product-buy-link { order: 4; display: inline-flex; } .tn-product-price { order: 5; margin-top: 18px; padding-top: 18px; } .tn-product-form { order: 6; } .tn-product-stock { order: 7; } .tn-product-trust { order: 8; grid-template-columns: 1fr; } .tn-product-points { order: 9; margin: 18px 0 0; padding-top: 18px; border-top: 1px solid var(--tn-line); } .tn-product:not(.tn-buy-mode) .tn-product-price, .tn-product:not(.tn-buy-mode) .tn-product-form, .tn-product:not(.tn-buy-mode) .tn-product-stock, .tn-product:not(.tn-buy-mode) .tn-product-trust { display: none; } .tn-product.tn-buy-mode { background: #fff; } .tn-product.tn-buy-mode .tn-product-wrap { width: 100%; } .tn-product.tn-buy-mode .tn-product-hero { display: flex; flex-direction: column; gap: 0; padding: 0 0 34px; } .tn-product.tn-buy-mode .tn-buy-mobile-header { order: 1; display: block; padding: 24px 20px 0; background: #fff; } .tn-product.tn-buy-mode .tn-product-gallery { order: 2; padding: 14px 16px 12px; background: #fff; } .tn-product.tn-buy-mode .tn-product-info { order: 3; width: calc(100% - 32px); margin: 0 auto; border: 0; border-radius: 0; background: #fff; box-shadow: none; padding: 6px 0 24px; } .tn-product.tn-buy-mode .tn-product-body { display: none; } .tn-product.tn-buy-mode .tn-buy-back { display: inline-flex; order: 0; margin: 0 0 16px; } .tn-product.tn-buy-mode .tn-product-kicker, .tn-product.tn-buy-mode .tn-product-title, .tn-product.tn-buy-mode .tn-product-summary, .tn-product.tn-buy-mode .tn-product-buy-link, .tn-product.tn-buy-mode .tn-product-points, .tn-product.tn-buy-mode .tn-product-price { display: none; } .tn-product.tn-buy-mode .tn-product-form, .tn-product.tn-buy-mode .tn-product-stock, .tn-product.tn-buy-mode .tn-product-trust { display: grid; } .tn-product.tn-buy-mode .tn-product-form { margin-top: 0; } .tn-product.tn-buy-mode .tn-product-main-image { border-radius: 20px; background: #f7f7f6; box-shadow: none; } .tn-product.tn-buy-mode .tn-product-main-image img { aspect-ratio: 4 / 3; object-fit: contain; padding: 4px; transform: scale(1.08); transform-origin: center; } .tn-product.tn-buy-mode .tn-product-thumbs { justify-content: center; padding-top: 10px; padding-bottom: 0; } .tn-product.tn-buy-mode.tn-single-sku-image .tn-product-thumbs { display: none; } .tn-product.tn-buy-mode .tn-product-thumb-button { width: 9px; height: 9px; flex-basis: 9px; border-radius: 999px; border: 0; background: rgba(32,38,31,.34); } .tn-product.tn-buy-mode .tn-product-thumb-button[aria-current="true"] { background: var(--tn-ink); } .tn-product.tn-buy-mode .tn-product-thumb-button img { display: none; } .tn-product.tn-buy-mode .tn-product-zoom-hint { display: none; } .tn-product.tn-buy-mode .tn-gallery-nav { display: none; } .tn-product.tn-buy-mode .tn-gallery-count { display: none; } .tn-variant-fieldset { margin-top: 4px; } .tn-variant-label { display: grid; gap: 3px; margin-bottom: 12px; } .tn-variant-label span { font-size: 22px; line-height: 1.15; } .tn-variant-grid { grid-template-columns: 1fr; gap: 12px; } .tn-variant-card { min-height: 104px; border-radius: 18px; padding: 18px 20px; display: grid; grid-template-columns: minmax(118px, 1fr) minmax(154px, auto); align-items: center; column-gap: 14px; } .tn-variant-card[aria-pressed="true"]::after { content: ""; top: 14px; right: 14px; width: 10px; height: 10px; border-radius: 999px; background: var(--tn-forest); } .tn-variant-top { align-self: center; display: grid; grid-template-columns: minmax(0, 1fr) 32px; align-items: center; gap: 10px; } .tn-variant-name { font-size: 22px; line-height: 1.12; overflow-wrap: anywhere; } .tn-variant-dot { align-self: center; justify-self: end; width: 28px; height: 28px; flex-basis: 28px; } .tn-variant-meta { margin-top: 0; justify-self: end; max-width: 162px; text-align: right; font-size: 13px; line-height: 1.28; padding-right: 0; } .tn-variant-meta span { display: block; } .tn-variant-meta span:first-child { font-size: 11px; color: var(--tn-muted); overflow-wrap: anywhere; word-break: break-word; } .tn-variant-meta span:nth-child(2) { color: var(--tn-ink); font-size: 17px; font-weight: 950; } .tn-variant-status { font-size: 12px; } .tn-product-row { grid-template-columns: 1fr; } .tn-product-price-value { font-size: 30px; } .tn-product-panel { padding: 22px; } .tn-product-body { padding-bottom: 58px; } .tn-gallery-nav { width: 38px; height: 38px; } .tn-product-zoom { padding: 16px; } .tn-zoom-nav { width: 42px; height: 42px; } }
</style>

<section class="tn-product" id="product-overview" data-tn-gallery-root>
  <div class="tn-product-wrap">
    <div class="tn-product-hero">
      <div class="tn-buy-mobile-header" data-tn-buy-screen-header>
        <h2 class="tn-buy-mobile-title">{{ product.title }}</h2>
      </div>
      <div class="tn-product-gallery">
        <div class="tn-product-thumbs" aria-label="Product images">
          {% for media in product.media limit: 8 %}
            {% if media.media_type == 'image' %}
              {% assign thumb_image = media.preview_image %}
              <button class="tn-product-thumb-button" type="button" aria-label="View image {{ forloop.index }}" aria-current="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}" data-tn-thumb data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" data-full-src="{{ thumb_image | image_url: width: 1400 }}" data-zoom-src="{{ thumb_image | image_url: width: 2400 }}" data-alt="{{ media.alt | default: product.title | escape }}">
                <img src="{{ thumb_image | image_url: width: 360 }}" loading="lazy" alt="{{ media.alt | default: product.title | escape }}" width="{{ thumb_image.width }}" height="{{ thumb_image.height }}">
              </button>
            {% endif %}
          {% endfor %}
        </div>
        <div class="tn-product-stage">
          {% assign featured_image = product.featured_media.preview_image %}
          <div class="tn-product-main-wrap">
            <button class="tn-product-main-image" type="button" data-tn-main-image aria-label="Open product image">
              {% if featured_image %}
                <img src="{{ featured_image | image_url: width: 1400 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="{{ featured_image.width }}" height="{{ featured_image.height }}" loading="eager" data-tn-main-img data-zoom-src="{{ featured_image | image_url: width: 2400 }}">
                <span class="tn-product-zoom-hint">Click to enlarge</span>
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </button>
            {% if product.media.size > 1 %}
              <button class="tn-gallery-nav tn-gallery-prev" type="button" data-tn-prev aria-label="Previous image">‹</button>
              <button class="tn-gallery-nav tn-gallery-next" type="button" data-tn-next aria-label="Next image">›</button>
            {% endif %}
          </div>
          {% if product.media.size > 1 %}<span class="tn-gallery-count" data-tn-count>1 / {{ product.media.size }}</span>{% endif %}
        </div>
      </div>

      <div class="tn-product-info" id="trailnest-buy" data-tn-buy-panel>
        <a class="tn-buy-back" href="#product-overview" data-tn-close-buy>‹ Back to product</a>
        <p class="tn-product-kicker">TrailNest Inflatable Tent</p>
        <h1 class="tn-product-title">{{ product.title }}</h1>
        <p class="tn-product-summary">A roomy inflatable cabin tent for family weekends, road trips, and relaxed glamping-style camping.</p>
        <a class="tn-product-buy-link" href="#trailnest-buy" data-tn-open-buy>Buy</a>
        <ul class="tn-product-points"><li>Spacious cabin-style interior for sleeping, gear, and longer stays</li><li>Inflatable air-beam structure designed for faster setup</li><li>Large window panels for airflow, daylight, and a more open feel</li><li>Includes pump, stakes, guy lines, and storage bag</li></ul>
        <div class="tn-product-price"><span class="tn-product-price-label">Price</span><span class="tn-product-price-value" data-tn-price>{{ product.selected_or_first_available_variant.price | money }}</span></div>
        {% form 'product', product, class: 'tn-product-form' %}
          {% unless product.has_only_default_variant %}
            <fieldset class="tn-variant-fieldset" aria-label="Choose color">
              <div class="tn-variant-label"><span>Color. Pick your favorite.</span><strong>Selected: <b data-tn-selected-option>{{ product.selected_or_first_available_variant.title }}</b></strong></div>
              <div class="tn-variant-grid">
                {% for variant in product.variants %}
                  {% assign variant_color = '#e8d8bf' %}
                  {% assign variant_title_downcase = variant.title | downcase %}
                  {% if variant_title_downcase contains 'olive' %}{% assign variant_color = '#808769' %}{% endif %}
                  <button class="tn-variant-card" type="button" data-tn-variant-card data-variant-id="{{ variant.id }}" aria-pressed="{% if variant == product.selected_or_first_available_variant %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>
                    <span class="tn-variant-top"><span class="tn-variant-name">{{ variant.title }}</span><span class="tn-variant-dot" style="--variant-color: {{ variant_color }}"></span></span>
                    <span class="tn-variant-meta"><span>SKU <b>{{ variant.sku | default: 'TrailNest' }}</b></span><span>{{ variant.price | money }}</span></span>
                  </button>
                {% endfor %}
              </div>
            </fieldset>
            <select class="tn-product-select" name="id" aria-label="Variant" data-tn-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}</option>{% endfor %}</select>
          {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
          <div class="tn-product-row"><input class="tn-product-qty" type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button class="tn-product-add" type="submit" data-tn-add {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button></div>
        {% endform %}
        <p class="tn-product-stock" data-tn-stock>{% if product.selected_or_first_available_variant.available %}In stock{% if product.selected_or_first_available_variant.inventory_management %}: {{ product.selected_or_first_available_variant.inventory_quantity }} available{% endif %}{% else %}Currently unavailable{% endif %}</p>
        <div class="tn-product-trust" aria-label="Purchase confidence">
          <span>Secure checkout</span>
          <span>USD pricing</span>
          <span>Order reviewed before payment</span>
          <span>In stock</span>
        </div>
      </div>
    </div>
    <div class="tn-product-body">
      <div class="tn-product-panel">
        <h2 class="tn-product-section-title">Room for the weekend, not just the night</h2>
        <p class="tn-product-section-copy">TrailNest is built around a cabin-style profile, giving families and weekend campers more usable interior space than a low-profile dome tent. Use it for sleeping bags, duffels, camp chairs, and the gear that usually ends up scattered around camp.</p>
        <div class="tn-product-proof-grid" aria-label="Interior space benefits">
          <div class="tn-product-proof"><b>Made for longer stays</b><span>Better for family weekends, road trips, lake camps, and relaxed glamping-style setups.</span></div>
          <div class="tn-product-proof"><b>Brighter inside</b><span>Large window panels help the tent feel more open, with daylight and airflow built into the cabin profile.</span></div>
          <div class="tn-product-proof"><b>Camp-friendly look</b><span>A neutral outdoor finish fits forest, lake, backyard, and campground settings without feeling overly technical.</span></div>
        </div>
      </div>

      <div class="tn-product-body-grid">
        <div class="tn-product-panel">
          <h2>Built for easier camp days</h2>
          <div class="tn-product-description">
            {% if product.description != blank %}
              {{ product.description }}
            {% else %}
              <p>TrailNest gear is made for practical outdoor living: easier setup, more usable space, and a warmer camp experience from arrival to morning coffee.</p>
            {% endif %}
          </div>
        </div>
        <div class="tn-product-panel">
          <h3>Product snapshot</h3>
          <div class="tn-product-specs">
            <div class="tn-product-spec"><span>Brand</span><b>{{ product.vendor | default: 'TrailNest' }}</b></div>
            <div class="tn-product-spec"><span>Type</span><b>{{ product.type | default: 'Inflatable Tent' }}</b></div>
            <div class="tn-product-spec"><span>Capacity</span><b>Family / group camping</b></div>
            <div class="tn-product-spec"><span>Structure</span><b>Inflatable air-beam cabin tent</b></div>
            <div class="tn-product-spec"><span>Best for</span><b>Car camping, weekends, road trips</b></div>
            <div class="tn-product-spec"><span>SKU</span><b data-tn-sku>{{ product.selected_or_first_available_variant.sku | default: 'TrailNest Tent' }}</b></div>
            <div class="tn-product-spec"><span>Availability</span><b data-tn-availability>{% if product.selected_or_first_available_variant.available %}In stock{% else %}Sold out{% endif %}</b></div>
          </div>
        </div>
      </div>

      <div class="tn-product-body-grid">
        <div class="tn-product-panel">
          <h3>What is included</h3>
          <ul class="tn-product-included">
            <li>Tent body</li>
            <li>Air pump</li>
            <li>Stakes</li>
            <li>Guy lines</li>
            <li>Storage bag</li>
          </ul>
        </div>
        <div class="tn-product-panel">
          <h3>Best for</h3>
          <div class="tn-product-description">
            <p>Family camping, car camping, lake weekends, backyard guest space, road trips, and glamping-style outdoor stays.</p>
            <p>The cabin-style shape is designed for people who want a more comfortable basecamp instead of a low, tight sleeping shelter.</p>
          </div>
        </div>
      </div>

      <div class="tn-product-panel">
        <h2 class="tn-product-section-title">Questions before you check out?</h2>
        <div class="tn-product-faq">
          <details><summary>How long does setup take?</summary><p>The inflatable air-beam structure is designed to make setup easier than traditional pole tents. Actual setup time depends on campsite conditions and how many people are helping.</p></details>
          <details><summary>What is included?</summary><p>The tent setup includes the tent body, pump, stakes, guy lines, and a storage bag.</p></details>
          <details><summary>Is this best for backpacking or car camping?</summary><p>TrailNest is best for car camping, family weekends, road trips, backyard guest space, and glamping-style outdoor stays.</p></details>
          <details><summary>How roomy is it inside?</summary><p>The cabin-style shape is designed to provide more usable interior space for sleeping, gear, and longer campsite stays.</p></details>
          <details><summary>Can it be used in rain?</summary><p>It is designed for normal outdoor camping conditions, but customers should always stake and guy out the tent properly and avoid severe weather.</p></details>
          <details><summary>Can I review my order before payment?</summary><p>Yes. Cart and checkout show the selected color, quantity, subtotal, shipping, taxes, and payment details before final payment.</p></details>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-tn-variants-json>
[
  {% for variant in product.variants %}
    {
      "id": {{ variant.id | json }},
      "title": {{ variant.title | json }},
      "sku": {{ variant.sku | json }},
      "price": {{ variant.price | money | json }},
      "available": {{ variant.available | json }},
      "inventoryQuantity": {{ variant.inventory_quantity | json }},
      "inventoryManaged": {{ variant.inventory_management | json }},
      "mediaIds": [{% for media in variant.media %}{{ media.id | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "featuredMediaId": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>

<div class="tn-product-zoom" data-tn-zoom aria-hidden="true">
  <button class="tn-product-zoom-close" type="button" data-tn-zoom-close aria-label="Close enlarged image">&times;</button>
  <button class="tn-zoom-nav tn-zoom-prev" type="button" data-tn-zoom-prev aria-label="Previous enlarged image">‹</button>
  <img src="" alt="" data-tn-zoom-img>
  <button class="tn-zoom-nav tn-zoom-next" type="button" data-tn-zoom-next aria-label="Next enlarged image">›</button>
</div>

<script>
  window.trailnestProductGallery = window.trailnestProductGallery || function(root) {
    var mainButton = root.querySelector('[data-tn-main-image]');
    var mainImg = root.querySelector('[data-tn-main-img]');
    var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-tn-thumb]'));
    var prev = root.querySelector('[data-tn-prev]');
    var next = root.querySelector('[data-tn-next]');
    var count = root.querySelector('[data-tn-count]');
    var zoom = document.querySelector('[data-tn-zoom]');
    var zoomImg = document.querySelector('[data-tn-zoom-img]');
    var zoomClose = document.querySelector('[data-tn-zoom-close]');
    var zoomPrev = document.querySelector('[data-tn-zoom-prev]');
    var zoomNext = document.querySelector('[data-tn-zoom-next]');
    var variantSelect = root.querySelector('[data-tn-variant-select]');
    var variantCards = Array.prototype.slice.call(root.querySelectorAll('[data-tn-variant-card]'));
    var variantJson = document.querySelector('[data-tn-variants-json]');
    var variants = [];
    try { variants = variantJson ? JSON.parse(variantJson.textContent) : []; } catch (error) { variants = []; }
    var selectedOption = root.querySelector('[data-tn-selected-option]');
    var price = root.querySelector('[data-tn-price]');
    var headerPrice = root.querySelector('[data-tn-buy-header-price]');
    var stock = root.querySelector('[data-tn-stock]');
    var sku = root.querySelector('[data-tn-sku]');
    var availability = root.querySelector('[data-tn-availability]');
    var addButton = root.querySelector('[data-tn-add]');
    var buyPanel = root.querySelector('[data-tn-buy-panel]');
    var buyOpeners = Array.prototype.slice.call(root.querySelectorAll('[data-tn-open-buy]'));
    var buyClose = root.querySelector('[data-tn-close-buy]');
    var activeIndex = Math.max(0, thumbs.findIndex(function(thumb) { return thumb.getAttribute('aria-current') === 'true'; }));
    var activeVariant = null;
    if (!mainButton || !mainImg || !thumbs.length || !zoom || !zoomImg || !zoomClose) return;
    function isOliveMedia(thumb) {
      return /olive/i.test(thumb.dataset.alt || '');
    }
    function variantImageIndexes(variant) {
      if (!variant) return thumbs.map(function(_, index) { return index; });
      var mediaIds = Array.isArray(variant.mediaIds) ? variant.mediaIds.map(String) : [];
      var indexes = [];
      if (mediaIds.length) {
        indexes = thumbs.reduce(function(acc, thumb, index) {
          if (mediaIds.indexOf(String(thumb.dataset.mediaId)) >= 0) acc.push(index);
          return acc;
        }, []);
      }
      if (!indexes.length && /olive/i.test(variant.title || '')) {
        var firstOliveIndex = thumbs.findIndex(isOliveMedia);
        if (firstOliveIndex >= 0) indexes = [firstOliveIndex];
      }
      if (!indexes.length && /beige/i.test(variant.title || '')) {
        var firstBeigeIndex = thumbs.findIndex(function(thumb) { return !isOliveMedia(thumb); });
        if (firstBeigeIndex >= 0) indexes = [firstBeigeIndex];
      }
      if (!indexes.length) indexes = thumbs.map(function(_, index) { return index; });
      return indexes.slice(0, 1);
    }
    function allImageIndexes() {
      return thumbs.map(function(_, index) { return index; });
    }
    function isBuyMode() {
      return root.classList.contains('tn-buy-mode');
    }
    function activeGalleryIndexes() {
      return isBuyMode() && activeVariant ? variantImageIndexes(activeVariant) : allImageIndexes();
    }
    function syncVariantThumbs() {
      var indexes = activeGalleryIndexes();
      var shouldFilter = isBuyMode() && activeVariant;
      root.classList.toggle('tn-single-sku-image', shouldFilter && indexes.length <= 1);
      thumbs.forEach(function(thumb, index) {
        var shouldHide = shouldFilter && indexes.indexOf(index) < 0;
        thumb.hidden = shouldHide;
        thumb.classList.toggle('is-hidden', shouldHide);
        if (shouldHide) {
          thumb.setAttribute('aria-hidden', 'true');
        } else {
          thumb.removeAttribute('aria-hidden');
        }
      });
    }
    function scopedShow(direction) {
      var indexes = activeGalleryIndexes();
      var currentPosition = indexes.indexOf(activeIndex);
      if (currentPosition < 0) currentPosition = 0;
      show(indexes[(currentPosition + direction + indexes.length) % indexes.length]);
    }
    function show(index) {
      activeIndex = (index + thumbs.length) % thumbs.length;
      var thumb = thumbs[activeIndex];
      mainImg.src = thumb.dataset.fullSrc;
      mainImg.dataset.zoomSrc = thumb.dataset.zoomSrc;
      mainImg.alt = thumb.dataset.alt || '';
      mainButton.setAttribute('aria-label', 'Open ' + (thumb.dataset.alt || 'product image'));
      syncVariantThumbs();
      thumbs.forEach(function(t, i) { t.setAttribute('aria-current', i === activeIndex ? 'true' : 'false'); });
      if (thumb.scrollIntoView) thumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      if (count) count.textContent = (activeIndex + 1) + ' / ' + thumbs.length;
      if (zoom.classList.contains('is-open')) { zoomImg.src = thumb.dataset.zoomSrc || thumb.dataset.fullSrc; zoomImg.alt = thumb.dataset.alt || ''; }
    }
    thumbs.forEach(function(thumb, index) { thumb.addEventListener('click', function() { show(index); }); });
    if (prev) prev.addEventListener('click', function() { scopedShow(-1); });
    if (next) next.addEventListener('click', function() { scopedShow(1); });
    var touchStartX = 0;
    var touchStartY = 0;
    var touchStartedAt = 0;
    mainButton.addEventListener('touchstart', function(event) {
      if (!event.touches || event.touches.length !== 1) return;
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
      touchStartedAt = Date.now();
    }, { passive: true });
    mainButton.addEventListener('touchend', function(event) {
      if (!event.changedTouches || event.changedTouches.length !== 1) return;
      var dx = event.changedTouches[0].clientX - touchStartX;
      var dy = event.changedTouches[0].clientY - touchStartY;
      var isHorizontalSwipe = Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy) * 1.35;
      if (!isHorizontalSwipe) return;
      if (Date.now() - touchStartedAt > 900) return;
      event.preventDefault();
      scopedShow(dx < 0 ? 1 : -1);
    }, { passive: false });
    function stockText(variant) {
      if (!variant || !variant.available) return 'Currently unavailable';
      return variant.inventoryManaged ? 'In stock: ' + variant.inventoryQuantity + ' available' : 'In stock';
    }
    function chooseVariant(variantId) {
      var variant = variants.find(function(item) { return String(item.id) === String(variantId); });
      if (!variant) return;
      if (variantSelect) {
        variantSelect.value = variant.id;
        variantSelect.dispatchEvent(new Event('input', { bubbles: true }));
      }
      variantCards.forEach(function(card) { card.setAttribute('aria-pressed', String(card.dataset.variantId) === String(variant.id) ? 'true' : 'false'); });
      var selectedCard = variantCards.find(function(card) { return String(card.dataset.variantId) === String(variant.id); });
      if (selectedCard && selectedCard.scrollIntoView) selectedCard.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      if (window.history && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      }
      if (selectedOption) selectedOption.textContent = variant.title || '';
      if (price) price.textContent = variant.price || '';
      if (headerPrice) headerPrice.textContent = variant.price || '';
      if (stock) stock.textContent = stockText(variant);
      if (sku) sku.textContent = variant.sku || 'TrailNest Tent';
      if (availability) availability.textContent = variant.available ? 'In stock' : 'Sold out';
      if (addButton) { addButton.disabled = !variant.available; addButton.textContent = variant.available ? 'Add to cart' : 'Sold out'; }
      activeVariant = variant;
      syncVariantThumbs();
      var indexes = activeGalleryIndexes();
      if (isBuyMode()) {
        show(indexes[0]);
      } else {
        show(activeIndex);
      }
    }
    variantCards.forEach(function(card) { card.addEventListener('click', function() { chooseVariant(card.dataset.variantId); }); });
    if (variantSelect) variantSelect.addEventListener('change', function() { chooseVariant(variantSelect.value); });
    if (variantSelect && variantSelect.value) chooseVariant(variantSelect.value);
    function setBuyMode(enabled, shouldScroll) {
      root.classList.toggle('tn-buy-mode', enabled);
      var indexes = activeGalleryIndexes();
      if (enabled && indexes.indexOf(activeIndex) < 0) {
        show(indexes[0]);
      } else {
        show(activeIndex);
      }
      if (shouldScroll) {
        var target = root;
        if (target && target.scrollIntoView) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    function openBuyFlow(event) {
      if (event) event.preventDefault();
      setBuyMode(true, true);
      if (window.history && window.history.pushState) {
        window.history.pushState({}, '', '#trailnest-buy');
      } else {
        window.location.hash = 'trailnest-buy';
      }
    }
    function closeBuyFlow(event) {
      if (event) event.preventDefault();
      setBuyMode(false, true);
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, '', window.location.pathname + window.location.search);
      }
    }
    buyOpeners.forEach(function(link) { link.addEventListener('click', openBuyFlow); });
    if (buyClose) buyClose.addEventListener('click', closeBuyFlow);
    window.addEventListener('hashchange', function() { setBuyMode(window.location.hash === '#trailnest-buy', false); });
    setBuyMode(window.location.hash === '#trailnest-buy', false);
    function openZoom() { var thumb = thumbs[activeIndex]; zoomImg.src = thumb.dataset.zoomSrc || mainImg.src; zoomImg.alt = mainImg.alt || ''; zoom.classList.add('is-open'); zoom.setAttribute('aria-hidden','false'); document.documentElement.style.overflow = 'hidden'; zoomClose.focus(); }
    function closeZoom() { zoom.classList.remove('is-open'); zoom.setAttribute('aria-hidden','true'); zoomImg.src = ''; document.documentElement.style.overflow = ''; mainButton.focus(); }
    mainButton.addEventListener('click', openZoom);
    zoomClose.addEventListener('click', closeZoom);
    if (zoomPrev) zoomPrev.addEventListener('click', function(e) { e.stopPropagation(); scopedShow(-1); });
    if (zoomNext) zoomNext.addEventListener('click', function(e) { e.stopPropagation(); scopedShow(1); });
    zoom.addEventListener('click', function(event) { if (event.target === zoom) closeZoom(); });
    document.addEventListener('keydown', function(event) { if (event.key === 'Escape' && zoom.classList.contains('is-open')) closeZoom(); if (event.key === 'ArrowLeft' && zoom.classList.contains('is-open')) scopedShow(-1); if (event.key === 'ArrowRight' && zoom.classList.contains('is-open')) scopedShow(1); });
    show(activeIndex);
  };
  document.querySelectorAll('[data-tn-gallery-root]').forEach(window.trailnestProductGallery);
</script>

