ct.tn-buy-mode .tn-product-buy-link, .tn-product.tn-buy-mode .tn-product-points, .tn-product.tn-buy-mode .tn-product-price { display: none; } .tn-product.tn-buy-mode .tn-product-form, .tn-product.tn-buy-mode .tn-product-stock, .tn-product.tn-buy-mode .tn-product-trust, .tn-product.tn-buy-mode .tn-buy-clarity { display: grid; } .tn-product.tn-buy-mode .tn-product-form { margin-top: 0; } .tn-product.tn-buy-mode .tn-product-main-image { border-radius: 20px; background: #f7f7f6; box-shadow: none; } .tn-product.tn-buy-mode .tn-product-main-image img { aspect-ratio: 4 / 3; object-fit: contain; padding: 4px; transform: scale(1.08); transform-origin: center; } .tn-product.tn-buy-mode .tn-product-thumbs { justify-content: center; padding-top: 10px; padding-bottom: 0; } .tn-product.tn-buy-mode.tn-single-sku-image .tn-product-thumbs { display: none; } .tn-product.tn-buy-mode .tn-product-thumb-button { width: 9px; height: 9px; flex-basis: 9px; border-radius: 999px; border: 0; background: rgba(32,38,31,.34); } .tn-product.tn-buy-mode .tn-product-thumb-button[aria-current="true"] { background: var(--tn-ink); } .tn-product.tn-buy-mode .tn-product-thumb-button img { display: none; } .tn-product.tn-buy-mode .tn-product-zoom-hint { display: none; } .tn-product.tn-buy-mode .tn-gallery-nav { display: none; } .tn-product.tn-buy-mode .tn-gallery-count { display: none; } .tn-variant-fieldset { margin-top: 4px; } .tn-variant-label { display: grid; gap: 3px; margin-bottom: 12px; } .tn-variant-label span { font-size: 22px; line-height: 1.15; } .tn-variant-grid { grid-template-columns: 1fr; gap: 12px; } .tn-variant-card { min-height: 104px; border-radius: 18px; padding: 18px 20px; display: grid; grid-template-columns: minmax(118px, 1fr) minmax(154px, auto); align-items: center; column-gap: 14px; } .tn-variant-card[aria-pressed="true"]::after { content: ""; top: 14px; right: 14px; width: 10px; height: 10px; border-radius: 999px; background: var(--tn-forest); } .tn-variant-top { align-self: center; display: grid; grid-template-columns: minmax(0, 1fr) 32px; align-items: center; gap: 10px; } .tn-variant-name { font-size: 22px; line-height: 1.12; overflow-wrap: anywhere; } .tn-variant-dot { align-self: center; justify-self: end; width: 28px; height: 28px; flex-basis: 28px; } .tn-variant-meta { margin-top: 0; justify-self: end; max-width: 162px; text-align: right; font-size: 13px; line-height: 1.28; padding-right: 0; } .tn-variant-meta span { display: block; } .tn-variant-meta span:first-child { font-size: 11px; color: var(--tn-muted); overflow-wrap: anywhere; word-break: break-word; } .tn-variant-meta span:nth-child(2) { color: var(--tn-ink); font-size: 17px; font-weight: 950; } .tn-variant-status { font-size: 12px; } .tn-product-row { grid-template-columns: 1fr; } .tn-product-price-value { font-size: 30px; } .tn-price-note { font-size: 12px; } .tn-product-panel { padding: 22px; } .tn-product-body { padding-bottom: 88px; } .tn-sticky-buy { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 50; min-height: 54px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px; padding: 8px 10px 8px 16px; border: 1px solid rgba(255,248,234,.28); border-radius: 999px; background: rgba(24,36,24,.96); color: var(--tn-paper); text-decoration: none; box-shadow: 0 14px 38px rgba(15,20,15,.28); } .tn-sticky-buy b { color: var(--tn-paper); font-size: 15px; font-weight: 950; } .tn-sticky-buy span { min-height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--tn-gold); color: var(--tn-forest); font-size: 13px; font-weight: 950; text-transform: uppercase; } .tn-product.tn-buy-mode .tn-sticky-buy { display: grid; } .tn-gallery-nav { width: 38px; height: 38px; } .tn-product-zoom { padding: 16px; } .tn-zoom-nav { width: 42px; height: 42px; } }


