{% schema %}
{
  "name": "Features",
  "settings": [],
  "presets": [{ "name": "Features" }]
}
{% endschema %}

<section class="py-24 bg-zinc-50 border-y border-zinc-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-[10px] font-black tracking-[0.4em] text-blue-600 uppercase mb-4 text-center">Engineered for Performance</h2>
      <p class="text-4xl font-black text-zinc-900 tracking-tighter leading-tight text-center">
        PRO LEVEL RECOVERY. <br class="hidden md:block">
        ANYTIME. ANYWHERE.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="text-center md:text-left">
        <div class="mb-6 inline-flex p-4 bg-white shadow-xl shadow-blue-900/5 rounded-2xl text-blue-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 mb-4 uppercase tracking-tighter">Thermal Lock Tech</h3>
        <p class="text-zinc-500 text-sm leading-relaxed">Reinforced 5-layer insulation material ensuring zero temperature escape during intense sessions.</p>
      </div>

      <div class="text-center md:text-left">
        <div class="mb-6 inline-flex p-4 bg-white shadow-xl shadow-blue-900/5 rounded-2xl text-blue-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polyline></svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 mb-4 uppercase tracking-tighter">Instant Assembly</h3>
        <p class="text-zinc-500 text-sm leading-relaxed">No tools required. Go from zero to ice-cold in less than 3 minutes with our express inflation system.</p>
      </div>

      <div class="text-center md:text-left">
        <div class="mb-6 inline-flex p-4 bg-white shadow-xl shadow-blue-900/5 rounded-2xl text-blue-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 mb-4 uppercase tracking-tighter">Travel Ready</h3>
        <p class="text-zinc-500 text-sm leading-relaxed">Compact design that fits in a carry-on. Perfect for training camps, races, or road trips.</p>
      </div>
    </div>
  </div>
</section>
