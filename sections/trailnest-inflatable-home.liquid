<style>
  #shopify-section-{{ section.id }} { --forest: #182418; --paper: #fff8ea; --ink: #20261f; --muted: #6c705f; --line: rgba(32, 38, 31, .14); --gold: #d8b56d; --clay: #a96945; color: var(--ink); background: var(--paper); }
  .trailnest-tent-home * { box-sizing: border-box; }
  .trailnest-tent-home { overflow: hidden; background: var(--paper); }
  .tn-wrap { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .tn-kicker { margin: 0 0 14px; color: var(--clay); font-size: 12px; font-weight: 950; letter-spacing: .14em; text-transform: uppercase; }
  .tn-button { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; padding: 0 22px; border: 1px solid transparent; border-radius: 4px; text-decoration: none; font-size: 15px; font-weight: 950; transition: transform .18s ease, background .18s ease, border-color .18s ease; text-align: center; }
  .tn-button:hover { transform: translateY(-1px); }
  .tn-button-primary { color: var(--forest); background: var(--gold); }
  .tn-button-secondary { color: var(--paper); border-color: rgba(255,248,234,.34); background: rgba(255,248,234,.08); }
  .tn-hero { position: relative; min-height: 720px; display: grid; align-items: center; padding: 88px 0 72px; color: var(--paper); background: var(--forest); }
  .tn-hero-media { position: absolute; inset: 0; }
  .tn-hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: .72; }
  .tn-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(24,36,24,.96), rgba(24,36,24,.72) 46%, rgba(24,36,24,.24)); }
  .tn-hero .tn-wrap { position: relative; z-index: 1; }
  .tn-hero-content { max-width: 760px; }
  .tn-badge { width: max-content; max-width: 100%; display: inline-flex; align-items: center; gap: 10px; padding: 8px 13px; border: 1px solid rgba(255,248,234,.3); border-radius: 999px; background: rgba(24,36,24,.62); color: #f4ead8; font-size: 13px; font-weight: 850; }
  .tn-badge span { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--gold); }
  .tn-hero h1 { margin: 22px 0 0; max-width: 780px; font-size: 72px; line-height: .98; font-weight: 950; letter-spacing: 0; }
  .tn-hero h1 em { color: var(--gold); font-style: normal; }
  .tn-hero-copy { margin: 24px 0 0; max-width: 650px; color: #e7ddca; font-size: 20px; line-height: 1.65; }
  .tn-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .tn-strip { background: var(--forest); color: var(--paper); border-top: 1px solid rgba(255,248,234,.16); }
  .tn-strip-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .tn-strip-item { min-height: 132px; padding: 24px; border-right: 1px solid rgba(255,248,234,.14); display: grid; align-content: center; }
  .tn-strip-item:last-child { border-right: 0; }
  .tn-strip-item strong { display: block; font-size: 30px; line-height: 1; color: var(--gold); }
  .tn-strip-item span { display: block; margin-top: 10px; color: #dcd2c1; font-size: 15px; font-weight: 800; line-height: 1.45; }
  .tn-section { padding: 96px 0; }
  .tn-section.green { background: var(--forest); color: var(--paper); }
  .tn-head { max-width: 820px; margin-bottom: 38px; }
  .tn-head h2 { margin: 0; font-size: 52px; line-height: 1.04; font-weight: 950; letter-spacing: 0; }
  .tn-head p { margin: 18px 0 0; color: var(--muted); font-size: 18px; line-height: 1.65; }
  .green .tn-head p { color: #dcd2c1; }
  .tn-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tn-feature-card { min-height: 300px; padding: 28px; border: 1px solid var(--line); border-radius: 8px; background: #fff; box-shadow: 0 18px 48px rgba(31,38,31,.06); }
  .tn-feature-card .tag { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 32px; border-radius: 6px; background: #e7dcc6; color: var(--forest); font-weight: 950; }
  .tn-feature-card h3 { margin: 0; font-size: 25px; line-height: 1.12; font-weight: 950; }
  .tn-feature-card p { margin: 12px 0 0; color: var(--muted); font-size: 16px; line-height: 1.65; }
  .tn-life { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 34px; align-items: center; }
  .tn-life img { width: 100%; min-height: 560px; object-fit: cover; border-radius: 8px; }
  .tn-life-copy h2 { margin: 0; font-size: 52px; line-height: 1.04; font-weight: 950; }
  .tn-life-copy p { margin: 18px 0 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .tn-promise { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 18px; align-items: stretch; }
  .tn-promise-panel { padding: 32px; border: 1px solid rgba(255,248,234,.18); border-radius: 8px; background: rgba(255,248,234,.07); }
  .tn-promise-panel h3 { margin: 0; font-size: 34px; line-height: 1.08; font-weight: 950; }
  .tn-promise-panel p { margin: 16px 0 0; color: #dcd2c1; font-size: 16px; line-height: 1.7; }
  .tn-checks { display: grid; gap: 12px; }
  .tn-check { padding: 22px; border: 1px solid rgba(255,248,234,.16); border-radius: 8px; background: rgba(255,248,234,.06); }
  .tn-check b { display: block; color: var(--gold); font-size: 18px; }
  .tn-check span { display: block; margin-top: 8px; color: #dcd2c1; font-size: 16px; line-height: 1.55; }
  .tn-final { padding: 88px 0; background: var(--forest); color: var(--paper); }
  .tn-final-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; align-items: center; }
  .tn-final h2 { margin: 0; max-width: 760px; font-size: 56px; line-height: 1.02; font-weight: 950; }
  .tn-final p { margin: 16px 0 0; max-width: 660px; color: #dcd2c1; font-size: 18px; line-height: 1.62; }
  @media (max-width: 960px) {
    .tn-hero { min-height: 640px; }
    .tn-hero h1 { font-size: 58px; }
    .tn-head h2, .tn-life-copy h2, .tn-final h2 { font-size: 42px; }
    .tn-feature-grid, .tn-life, .tn-promise, .tn-final-grid { grid-template-columns: 1fr; }
    .tn-strip-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tn-life img { min-height: 440px; }
  }
  @media (max-width: 620px) {
    .tn-wrap { width: min(100% - 24px, 1200px); }
    .tn-hero { min-height: 560px; padding: 58px 0; align-items: end; }
    .tn-hero-media img { object-position: 58% center; opacity: .62; }
    .tn-hero::after { background: linear-gradient(180deg, rgba(24,36,24,.28), rgba(24,36,24,.94) 70%); }
    .tn-badge { font-size: 12px; line-height: 1.35; }
    .tn-hero h1 { font-size: 40px; line-height: 1.03; }
    .tn-hero-copy { font-size: 16px; line-height: 1.58; }
    .tn-actions, .tn-button { width: 100%; }
    .tn-button { min-height: 50px; }
    .tn-strip-grid { grid-template-columns: 1fr; }
    .tn-strip-item { min-height: 104px; border-right: 0; border-bottom: 1px solid rgba(255,248,234,.14); }
    .tn-section { padding: 62px 0; }
    .tn-head h2, .tn-life-copy h2, .tn-final h2 { font-size: 34px; }
    .tn-head p, .tn-life-copy p, .tn-final p { font-size: 16px; }
    .tn-feature-card { min-height: auto; padding: 22px; }
    .tn-feature-card h3 { font-size: 22px; }
    .tn-life img { min-height: 320px; }
    .tn-promise-panel { padding: 24px; }
    .tn-promise-panel h3 { font-size: 28px; }
    .tn-final { padding: 64px 0; }
  }
</style>

<div class="trailnest-tent-home">
  <section class="tn-hero">
    <div class="tn-hero-media" aria-hidden="true"><img src="{{ 'trailnest-inflatable-tent-hero.jpg' | asset_url }}" alt=""></div>
    <div class="tn-wrap"><div class="tn-hero-content">
      <div class="tn-badge"><span></span>{{ 'trailnest.home.badge' | t }}</div>
      <h1>{{ 'trailnest.home.hero_title_before' | t }} <em>{{ 'trailnest.home.hero_title_em' | t }}</em></h1>
      <p class="tn-hero-copy">{{ 'trailnest.home.hero_copy' | t }}</p>
      <div class="tn-actions"><a class="tn-button tn-button-primary" href="/collections/all-products">{{ 'trailnest.actions.shop_inflatable_tents' | t }}</a><a class="tn-button tn-button-secondary" href="/#tent-life">{{ 'trailnest.actions.explore_tent_life' | t }}</a></div>
    </div></div>
  </section>
  <section class="tn-strip"><div class="tn-wrap tn-strip-grid">
    <div class="tn-strip-item"><strong>{{ 'trailnest.home.strip_air_title' | t }}</strong><span>{{ 'trailnest.home.strip_air_copy' | t }}</span></div>
    <div class="tn-strip-item"><strong>{{ 'trailnest.home.strip_room_title' | t }}</strong><span>{{ 'trailnest.home.strip_room_copy' | t }}</span></div>
    <div class="tn-strip-item"><strong>{{ 'trailnest.home.strip_light_title' | t }}</strong><span>{{ 'trailnest.home.strip_light_copy' | t }}</span></div>
    <div class="tn-strip-item"><strong>{{ 'trailnest.home.strip_camp_title' | t }}</strong><span>{{ 'trailnest.home.strip_camp_copy' | t }}</span></div>
  </div></section>
  <section class="tn-section"><div class="tn-wrap">
    <div class="tn-head"><p class="tn-kicker">{{ 'trailnest.home.why_kicker' | t }}</p><h2>{{ 'trailnest.home.why_title' | t }}</h2><p>{{ 'trailnest.home.why_copy' | t }}</p></div>
    <div class="tn-feature-grid">
      <div class="tn-feature-card"><span class="tag">01</span><h3>{{ 'trailnest.home.feature_1_title' | t }}</h3><p>{{ 'trailnest.home.feature_1_copy' | t }}</p></div>
      <div class="tn-feature-card"><span class="tag">02</span><h3>{{ 'trailnest.home.feature_2_title' | t }}</h3><p>{{ 'trailnest.home.feature_2_copy' | t }}</p></div>
      <div class="tn-feature-card"><span class="tag">03</span><h3>{{ 'trailnest.home.feature_3_title' | t }}</h3><p>{{ 'trailnest.home.feature_3_copy' | t }}</p></div>
    </div>
  </div></section>
  <section id="tent-life" class="tn-section"><div class="tn-wrap tn-life">
    <img src="{{ 'trailnest-inflatable-tent-hero.jpg' | asset_url }}" alt="{{ 'trailnest.home.hero_alt' | t | escape }}">
    <div class="tn-life-copy"><p class="tn-kicker">{{ 'trailnest.home.life_kicker' | t }}</p><h2>{{ 'trailnest.home.life_title' | t }}</h2><p>{{ 'trailnest.home.life_copy_1' | t }}</p><p>{{ 'trailnest.home.life_copy_2' | t }}</p><div class="tn-actions"><a class="tn-button tn-button-primary" href="/collections/all-products">{{ 'trailnest.actions.find_your_tent' | t }}</a></div></div>
  </div></section>
  <section class="tn-section green"><div class="tn-wrap tn-promise">
    <div class="tn-promise-panel"><p class="tn-kicker">{{ 'trailnest.home.promise_kicker' | t }}</p><h3>{{ 'trailnest.home.promise_title' | t }}</h3><p>{{ 'trailnest.home.promise_copy_1' | t }}</p><p>{{ 'trailnest.home.promise_copy_2' | t }}</p></div>
    <div class="tn-checks"><div class="tn-check"><b>{{ 'trailnest.home.check_1_title' | t }}</b><span>{{ 'trailnest.home.check_1_copy' | t }}</span></div><div class="tn-check"><b>{{ 'trailnest.home.check_2_title' | t }}</b><span>{{ 'trailnest.home.check_2_copy' | t }}</span></div><div class="tn-check"><b>{{ 'trailnest.home.check_3_title' | t }}</b><span>{{ 'trailnest.home.check_3_copy' | t }}</span></div></div>
  </div></section>
  <section class="tn-final"><div class="tn-wrap tn-final-grid"><div><p class="tn-kicker">{{ 'trailnest.home.final_kicker' | t }}</p><h2>{{ 'trailnest.home.final_title' | t }}</h2><p>{{ 'trailnest.home.final_copy' | t }}</p></div><a class="tn-button tn-button-primary" href="/collections/all-products">{{ 'trailnest.actions.shop_inflatable_tents' | t }}</a></div></section>
</div>

{% schema %}
{
  "name": "Inflatable Tents",
  "settings": [],
  "presets": [{ "name": "Inflatable Tents" }]
}
{% endschema %}
