{% assign shelter_collection = collections['all-products'] %}
{% assign rooftop_product = all_products['trailnest-wedge-132-aluminum-hard-shell-rooftop-tent'] %}
<div class="tnp-home">
  <section class="tnp-hero">
    <img class="tnp-hero__image" src="{{ 'trailnest-national-park-hero.jpg' | asset_url }}" alt="TrailNest rooftop tent on an SUV overlooking a national park valley at sunrise" fetchpriority="high">
    <div class="tnp-shell">
      <div class="tnp-hero__content">
        <p class="tnp-eyebrow">TrailNest Rooftop Tents / Available Now</p>
        <h1>Go far.<em>Sleep well.</em></h1>
        <p class="tnp-hero__copy">Road-ready shelter for farther weekends and better nights outside.</p>
        <div class="tnp-hero__actions">
          <a class="tnp-button" href="{{ rooftop_product.url | default: '/collections/all-products#rooftop-tents' }}">Shop rooftop tents <span class="tnp-arrow">→</span></a>
          <a class="tnp-text-link" href="/collections/all-products#inflatable-tents">Shop inflatable tents <span class="tnp-arrow">→</span></a>
        </div>
      </div>
    </div>
    <div class="tnp-hero__meta"><span>Expedition archive / 001</span><span>37.7459° N · 119.5332° W</span></div>
  </section>

  <section class="tnp-gateway" aria-label="Shop TrailNest collections">
    <a class="tnp-cover" href="{{ rooftop_product.url | default: '/collections/all-products#rooftop-tents' }}">
      <img src="{{ 'trailnest-rooftop-forest.jpg' | asset_url }}" alt="TrailNest rooftop tent in a pine forest" loading="lazy">
      <div class="tnp-cover__copy"><span>Collection 01</span><h2>Rooftop<br>Tents</h2><p>Flagship shelter system <span class="tnp-arrow">→</span></p></div>
    </a>
    <a class="tnp-cover" href="/collections/all-products#inflatable-tents">
      <img src="{{ 'trailnest-inflatable-family.jpg' | asset_url }}" alt="TrailNest inflatable cabin tent at camp" loading="lazy">
      <div class="tnp-cover__copy"><span>Collection 02</span><h2>Inflatable<br>Tents</h2><p>Room to settle in <span class="tnp-arrow">→</span></p></div>
    </a>
  </section>

  <section class="tnp-flagship">
    <div class="tnp-shell tnp-flagship__grid">
      <div class="tnp-flagship__copy">
        <p class="tnp-eyebrow">Flagship rooftop system</p>
        <h2>Made for<br><em>the way out.</em></h2>
        <p>A low-profile hard-shell rooftop tent built to turn road trips, long weekends, and changing plans into a simpler way to camp.</p>
        <a class="tnp-text-link" href="{{ rooftop_product.url | default: '/collections/all-products#rooftop-tents' }}">View rooftop tent <span class="tnp-arrow">→</span></a>
      </div>
      <a class="tnp-flagship__media" href="{{ rooftop_product.url | default: '/collections/all-products#rooftop-tents' }}">
        <img src="{{ 'trailnest-wedge-132-rooftop-tent-minimal-suv-white.jpg' | asset_url }}" alt="TrailNest Wedge 132 rooftop tent installed on an SUV" loading="lazy">
        <div class="tnp-flagship__caption"><span>TrailNest Wedge 132</span><span>Rooftop collection / 01</span></div>
      </a>
    </div>
  </section>

  <section class="tnp-shop">
    <div class="tnp-shell">
      <header class="tnp-section-head"><div><p class="tnp-eyebrow">Current collection</p><h2>Choose your shelter.</h2></div><a class="tnp-text-link" href="/collections/all-products">Shop all <span class="tnp-arrow">→</span></a></header>
      {% if shelter_collection.products_count > 0 %}
        <div class="tnp-product-grid">
          {% for product in shelter_collection.products limit: 6 %}
            <a class="tnp-card" href="{{ product.url }}">
              <div class="tnp-card__image">
                {% if product.handle == 'trailnest-wedge-132-aluminum-hard-shell-rooftop-tent' %}
                  <img src="{{ 'trailnest-wedge-132-rooftop-tent-minimal-suv-white.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">
                {% elsif product.featured_image %}
                  {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product.title }}
                {% endif %}
              </div>
              <div class="tnp-card__copy"><span>{% if product.handle contains 'rooftop' %}Flagship rooftop system{% else %}Inflatable shelter{% endif %}</span><h3>{{ product.title | escape }}</h3><div class="tnp-card__bottom"><b>{{ product.price | money }}</b><b>View product <span class="tnp-arrow">→</span></b></div></div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  <section class="tnp-pledge"><div class="tnp-pledge__inner"><p class="tnp-eyebrow">The TrailNest way</p><h2>Less friction.<br>More horizon.</h2><p>Good shelter should make leaving easier, setup quieter, and the morning outside feel closer.</p><a class="tnp-text-link" href="/pages/about-trailnest">Our story <span class="tnp-arrow">→</span></a></div></section>
</div>
{% schema %}
{"name":"TrailNest Park Home","settings":[],"presets":[{"name":"TrailNest Park Home"}]}
{% endschema %}
