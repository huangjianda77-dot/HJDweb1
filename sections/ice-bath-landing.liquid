{% liquid
  assign featured_product = all_products['1st-plunge-ice-bath-recovery-kit-premium-cold-therapy-system']
  assign variant = featured_product.selected_or_first_available_variant
  assign primary_image = featured_product.featured_image
%}

<style>
  #shopify-section-{{ section.id }} {
    --midnight: #0f172a;
    --midnight-2: #111c31;
    --ice: #38bdf8;
    --ice-soft: #e0f7ff;
    --ghost: #f8fafc;
    --line: rgba(148, 163, 184, .26);
    --muted: #64748b;
    --ink: #0b1220;
    --white: #ffffff;
    color: var(--ink);
    background: var(--ghost);
  }

  .plunge-page * { box-sizing: border-box; }
  .plunge-page { overflow: hidden; background: var(--ghost); }
  .plunge-wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
  .plunge-kicker {
    margin: 0 0 14px;
    color: var(--ice);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .plunge-btn {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 3px;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .plunge-btn:hover { transform: translateY(-1px); }
  .plunge-btn-primary {
    background: var(--ice);
    color: #03111f;
    box-shadow: 0 20px 45px rgba(56, 189, 248, .28);
  }
  .plunge-btn-secondary {
    color: var(--white);
    border-color: rgba(255,255,255,.22);
    background: rgba(255,255,255,.06);
  }

  .plunge-sticky {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(15, 23, 42, .94);
    backdrop-filter: blur(12px);
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .plunge-sticky-inner {
    min-height: 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-size: 13px;
    font-weight: 800;
  }
  .plunge-sticky-price { color: var(--ice); }
  .plunge-sticky form { margin: 0; }
  .plunge-sticky .plunge-btn { min-height: 36px; padding: 0 14px; font-size: 12px; }

  .plunge-hero {
    color: #fff;
    min-height: 84vh;
    display: grid;
    align-items: center;
    padding: 72px 0 62px;
    background:
      linear-gradient(105deg, rgba(15,23,42,.98) 0%, rgba(15,23,42,.92) 42%, rgba(15,23,42,.60) 100%),
      radial-gradient(circle at 78% 24%, rgba(56,189,248,.28), transparent 34%),
      linear-gradient(135deg, #0f172a 0%, #132238 100%);
  }
  .plunge-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .96fr) minmax(370px, 1.04fr);
    gap: 58px;
    align-items: center;
  }
  .plunge-hero h1 {
    margin: 0;
    max-width: 760px;
    font-size: clamp(44px, 7vw, 86px);
    line-height: .92;
    letter-spacing: 0;
    font-weight: 950;
  }
  .plunge-hero-copy {
    margin: 22px 0 0;
    max-width: 650px;
    color: #cbd5e1;
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.58;
  }
  .plunge-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .plunge-actions form { margin: 0; }
  .plunge-savings {
    margin-top: 16px;
    color: #dbeafe;
    font-size: 14px;
    font-weight: 800;
  }
  .plunge-savings s { color: #94a3b8; margin-left: 8px; }
  .plunge-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 34px;
    max-width: 720px;
  }
  .plunge-proof span {
    min-height: 74px;
    display: grid;
    align-content: center;
    padding: 14px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.045);
    border-radius: 4px;
    color: #dbeafe;
    font-size: 13px;
    font-weight: 850;
  }
  .plunge-proof b { display: block; color: #fff; font-size: 24px; line-height: 1; margin-bottom: 6px; }

  .plunge-product-stage { position: relative; min-height: 570px; display: grid; place-items: center; }
  .plunge-product-card {
    width: min(510px, 100%);
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    padding: 30px;
    border-radius: 6px;
    background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(226,242,251,.96));
    border: 1px solid rgba(255,255,255,.36);
    box-shadow: 0 40px 90px rgba(0,0,0,.35);
  }
  .plunge-product-card img { width: 100%; height: 100%; object-fit: contain; }
  .plunge-float {
    position: absolute;
    padding: 16px;
    border-radius: 4px;
    background: rgba(15,23,42,.88);
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: 0 22px 54px rgba(0,0,0,.28);
    color: #fff;
  }
  .plunge-float strong { display: block; font-size: 34px; line-height: 1; }
  .plunge-float span { display: block; margin-top: 8px; color: #bae6fd; font-size: 12px; font-weight: 850; text-transform: uppercase; letter-spacing: .06em; }
  .plunge-float.temp { left: 0; bottom: 64px; width: 174px; }
  .plunge-float.sound { right: 0; top: 54px; width: 184px; }

  .plunge-band { padding: 90px 0; }
  .plunge-band-white { background: #fff; }
  .plunge-head { max-width: 780px; margin-bottom: 36px; }
  .plunge-head h2 {
    margin: 0;
    color: var(--midnight);
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1;
    letter-spacing: 0;
    font-weight: 950;
  }
  .plunge-head p { margin: 18px 0 0; color: var(--muted); font-size: 18px; line-height: 1.65; }

  .plunge-silent {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .plunge-silent-item { min-height: 160px; padding: 26px; background: #fff; }
  .plunge-silent-item strong { display: block; color: var(--midnight); font-size: 38px; line-height: 1; }
  .plunge-silent-item span { display: block; margin-top: 12px; color: var(--muted); font-weight: 800; line-height: 1.45; }

  .plunge-advantage {
    display: grid;
    grid-template-columns: .92fr 1.08fr;
    gap: 42px;
    align-items: center;
  }
  .plunge-lab-card {
    min-height: 520px;
    padding: 28px;
    display: grid;
    align-content: end;
    background:
      linear-gradient(180deg, rgba(15,23,42,.10), rgba(15,23,42,.88)),
      radial-gradient(circle at 50% 24%, rgba(56,189,248,.32), transparent 28%),
      #101b2d;
    color: #fff;
    border-radius: 6px;
    overflow: hidden;
  }
  .plunge-lab-card h3 { margin: 0; font-size: 36px; line-height: 1; font-weight: 950; }
  .plunge-lab-card p { margin: 14px 0 0; color: #cbd5e1; line-height: 1.6; }
  .plunge-feature-list { display: grid; gap: 14px; }
  .plunge-feature-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    align-items: start;
    padding: 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .plunge-icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: var(--ice-soft);
    color: #0369a1;
    border-radius: 4px;
    font-weight: 950;
  }
  .plunge-feature-row h3 { margin: 0; color: var(--midnight); font-size: 21px; font-weight: 950; }
  .plunge-feature-row p { margin: 7px 0 0; color: var(--muted); line-height: 1.56; }

  .plunge-compare {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .plunge-compare-card {
    padding: 26px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .plunge-compare-card.is-featured {
    background: var(--midnight);
    color: #fff;
    border-color: var(--midnight);
    box-shadow: 0 28px 70px rgba(15,23,42,.25);
  }
  .plunge-compare-card h3 { margin: 0 0 18px; font-size: 24px; font-weight: 950; }
  .plunge-compare-card ul { display: grid; gap: 13px; margin: 0; padding: 0; list-style: none; }
  .plunge-compare-card li { color: var(--muted); line-height: 1.48; }
  .plunge-compare-card.is-featured li { color: #dbeafe; }
  .plunge-compare-price { margin: 0 0 18px; color: var(--ice); font-size: 30px; font-weight: 950; }

  .plunge-sound {
    display: grid;
    grid-template-columns: .88fr 1.12fr;
    gap: 38px;
    align-items: center;
    padding: 34px;
    background: var(--midnight);
    color: #fff;
    border-radius: 6px;
  }
  .plunge-sound h2 { margin: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1.05; font-weight: 950; }
  .plunge-sound p { margin: 14px 0 0; color: #cbd5e1; line-height: 1.6; }
  .plunge-meter { display: grid; gap: 18px; }
  .plunge-meter-row span { display: flex; justify-content: space-between; margin-bottom: 8px; font-weight: 850; }
  .plunge-track { height: 12px; background: rgba(255,255,255,.12); border-radius: 999px; overflow: hidden; }
  .plunge-fill { height: 100%; background: var(--ice); border-radius: 999px; }
  .plunge-fill.standard { width: 78%; background: #fb7185; }
  .plunge-fill.quiet { width: 44%; }

  .plunge-kit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .plunge-kit-card {
    min-height: 230px;
    display: grid;
    align-content: end;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(248,250,252,.1), rgba(15,23,42,.9)),
      radial-gradient(circle at 50% 20%, rgba(56,189,248,.22), transparent 32%),
      #172033;
    color: #fff;
  }
  .plunge-kit-card h3 { margin: 0; font-size: 20px; font-weight: 950; }
  .plunge-kit-card p { margin: 8px 0 0; color: #cbd5e1; line-height: 1.45; }

  .plunge-final {
    padding: 76px 0;
    background:
      linear-gradient(90deg, rgba(15,23,42,.97), rgba(15,23,42,.86)),
      radial-gradient(circle at 76% 40%, rgba(56,189,248,.20), transparent 30%),
      var(--midnight);
    color: #fff;
  }
  .plunge-final-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
  }
  .plunge-final h2 { margin: 0; font-size: clamp(34px, 5vw, 58px); line-height: 1; font-weight: 950; }
  .plunge-final p { margin: 14px 0 0; color: #cbd5e1; font-size: 18px; }
  .plunge-final form { margin: 0; }

  @media (max-width: 920px) {
    .plunge-hero { min-height: auto; padding: 54px 0; }
    .plunge-hero-grid,
    .plunge-advantage,
    .plunge-sound,
    .plunge-final-grid { grid-template-columns: 1fr; }
    .plunge-product-stage { min-height: auto; padding: 18px 0 96px; }
    .plunge-float.temp { left: 8px; bottom: 8px; }
    .plunge-float.sound { right: 8px; top: 8px; }
    .plunge-silent,
    .plunge-compare,
    .plunge-kit-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .plunge-wrap { width: min(100% - 24px, 1180px); }
    .plunge-sticky-inner { align-items: flex-start; flex-direction: column; padding: 10px 0; }
    .plunge-sticky .plunge-btn { width: 100%; }
    .plunge-actions .plunge-btn, .plunge-actions form, .plunge-final form, .plunge-final .plunge-btn { width: 100%; }
    .plunge-proof { grid-template-columns: 1fr; }
    .plunge-product-stage { display: block; padding-bottom: 0; }
    .plunge-float { position: static; width: 100%; margin-top: 12px; }
    .plunge-band { padding: 64px 0; }
    .plunge-sound { padding: 24px; }
  }
</style>

<div class="plunge-page">
  <div class="plunge-sticky">
    <div class="plunge-wrap plunge-sticky-inner">
      <span>1st Plunge Recovery Kit <span class="plunge-sticky-price">{{ variant.price | money }}</span> <s>{{ variant.compare_at_price | money }}</s></span>
      {% if variant %}
        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button class="plunge-btn plunge-btn-primary" type="submit">Buy Now</button>
        </form>
      {% endif %}
    </div>
  </div>

  <section class="plunge-hero">
    <div class="plunge-wrap plunge-hero-grid">
      <div>
        <p class="plunge-kicker">Elite cold therapy, built for home</p>
        <h1>The Gold Standard of Cold.</h1>
        <p class="plunge-hero-copy">Professional recovery without daily ice runs. A complete 1/3 HP chiller and 148-gallon plunge system engineered for consistent cold, cleaner circulation, and quiet home use.</p>
        <div class="plunge-actions">
          {% if variant %}
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button class="plunge-btn plunge-btn-primary" type="submit">Secure Yours - {{ variant.price | money }}</button>
            </form>
          {% endif %}
          <a class="plunge-btn plunge-btn-secondary" href="/products/{{ featured_product.handle }}">View Product Details</a>
        </div>
        <div class="plunge-savings">Save {{ variant.compare_at_price | minus: variant.price | money }} today <s>{{ variant.compare_at_price | money }}</s></div>
        <div class="plunge-proof">
          <span><b>42°F</b>Consistent chill target</span>
          <span><b>40dB</b>Whisper quiet operation</span>
          <span><b>148Gal</b>XL insulated tub</span>
        </div>
      </div>
      <div class="plunge-product-stage">
        <div class="plunge-product-card">
          {% if primary_image %}
            {{ primary_image | image_url: width: 1000 | image_tag: loading: 'eager', alt: featured_product.title }}
          {% endif %}
        </div>
        <div class="plunge-float temp"><strong>42°F</strong><span>No ice required</span></div>
        <div class="plunge-float sound"><strong>40dB</strong><span>Library-level quiet</span></div>
      </div>
    </div>
  </section>

  <section class="plunge-band plunge-band-white">
    <div class="plunge-wrap">
      <div class="plunge-silent">
        <div class="plunge-silent-item"><strong>1/3 HP</strong><span>Dedicated chiller for repeat recovery sessions.</span></div>
        <div class="plunge-silent-item"><strong>XL</strong><span>148-gallon tub gives you more room than compact barrels.</span></div>
        <div class="plunge-silent-item"><strong>Kit</strong><span>Chiller, tub, pump, filter, and insulated hoses included.</span></div>
      </div>
    </div>
  </section>

  <section class="plunge-band">
    <div class="plunge-wrap plunge-advantage">
      <div class="plunge-lab-card">
        <p class="plunge-kicker">The 1st Plunge advantage</p>
        <h3>Engineering that does not just chill. It transforms the ritual.</h3>
        <p>Designed around the parts that matter most: cooling, circulation, filtration, insulation, and a setup simple enough for home recovery spaces.</p>
      </div>
      <div class="plunge-feature-list">
        <div class="plunge-feature-row"><span class="plunge-icon">01</span><div><h3>Plug-and-play cold</h3><p>Set up a reliable cold plunge routine without hauling ice before every session.</p></div></div>
        <div class="plunge-feature-row"><span class="plunge-icon">02</span><div><h3>External filtration</h3><p>The included filter and pump support cleaner water movement between plunges.</p></div></div>
        <div class="plunge-feature-row"><span class="plunge-icon">03</span><div><h3>Insulated system</h3><p>The tub and hoses are built to help hold cold temperatures longer.</p></div></div>
      </div>
    </div>
  </section>

  <section class="plunge-band plunge-band-white">
    <div class="plunge-wrap">
      <div class="plunge-head">
        <p class="plunge-kicker">Why switch</p>
        <h2>Stop buying ice. Start your ritual.</h2>
        <p>Positioned between disposable ice baths and expensive luxury plunges, 1st Plunge gives home athletes the core equipment they actually need.</p>
      </div>
      <div class="plunge-compare">
        <div class="plunge-compare-card">
          <h3>Ice bags</h3>
          <p class="plunge-compare-price">Daily cost</p>
          <ul>
            <li>Requires constant ice runs</li>
            <li>Inconsistent temperatures</li>
            <li>More cleanup and more skipped sessions</li>
          </ul>
        </div>
        <div class="plunge-compare-card is-featured">
          <h3>1st Plunge</h3>
          <p class="plunge-compare-price">{{ variant.price | money }}</p>
          <ul>
            <li>1/3 HP chiller included</li>
            <li>External pump and filter included</li>
            <li>148-gallon XL insulated tub included</li>
          </ul>
        </div>
        <div class="plunge-compare-card">
          <h3>Luxury plunge</h3>
          <p class="plunge-compare-price">$5k+</p>
          <ul>
            <li>Premium price point</li>
            <li>Often heavier and harder to move</li>
            <li>More than many home users need</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="plunge-band">
    <div class="plunge-wrap">
      <div class="plunge-sound">
        <div>
          <p class="plunge-kicker">Silent power</p>
          <h2>Quiet enough for the garage, patio, or recovery room.</h2>
          <p>At around 40dB, the chiller is designed to keep recovery from becoming background noise.</p>
        </div>
        <div class="plunge-meter">
          <div class="plunge-meter-row"><span><b>1st Plunge</b><b>40dB</b></span><div class="plunge-track"><div class="plunge-fill quiet"></div></div></div>
          <div class="plunge-meter-row"><span><b>Typical loud appliance</b><b>70dB</b></span><div class="plunge-track"><div class="plunge-fill standard"></div></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="plunge-band plunge-band-white">
    <div class="plunge-wrap">
      <div class="plunge-head">
        <p class="plunge-kicker">Inside the kit</p>
        <h2>Everything needed to begin cold recovery.</h2>
      </div>
      <div class="plunge-kit-grid">
        <div class="plunge-kit-card"><h3>Insulated Tub</h3><p>148-gallon XL plunge capacity.</p></div>
        <div class="plunge-kit-card"><h3>1/3 HP Chiller</h3><p>Cold water without ice runs.</p></div>
        <div class="plunge-kit-card"><h3>External Filter</h3><p>Supports cleaner circulation.</p></div>
        <div class="plunge-kit-card"><h3>Pro Hoses</h3><p>Insulated connections included.</p></div>
      </div>
    </div>
  </section>

  <section class="plunge-final">
    <div class="plunge-wrap plunge-final-grid">
      <div>
        <p class="plunge-kicker">Limited offer</p>
        <h2>Professional recovery. Home comfort.</h2>
        <p>Order the complete 1st Plunge Recovery Kit today and save against the regular price.</p>
      </div>
      {% if variant %}
        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button class="plunge-btn plunge-btn-primary" type="submit">Shop the Recovery Kit - {{ variant.price | money }}</button>
        </form>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Ice Bath Landing Page",
  "settings": [],
  "presets": [
    {
      "name": "Ice Bath Landing Page"
    }
  ]
}
{% endschema %}
